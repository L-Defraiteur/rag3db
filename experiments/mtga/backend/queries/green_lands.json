{
  "name": "select_cards",
  "arguments": {
    "filter": {
      "must": [
        {
          "field": {
            "key": "is_land",
            "value": true
          }
        },
        {
          "path": {
            "path": [
              "mana_symbols_possible"
            ],
            "value": [
              {
                "op": "has_any",
                "value": [
                  "G"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}