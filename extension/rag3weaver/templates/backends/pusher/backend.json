{
  "version": 1,
  "name": "pusher",
  "database": "data/pusher.rag3db",
  "embeddings": {
    "model": "bge-m3",
    "dimensions": 1024
  },
  "vector_extension": "vector",
  "models": {
    "llm": {
      "provider": "compatible",
      "protocol": "vertex",
      "model": "google/gemini-3.1-flash-lite",
      "params": { "location": "global" }
    }
  },
  "entities": {},
  "tools": {
    "lot_judge": {
      "graph": "../../pusher/judge.mmd",
      "description": "The lot judge: reads a lot's diff, AGENTS.md and the judge's rules, and gives findings {rule, file, line, excerpt, severity, why}. An opinion: it blocks nothing."
    }
  }
}
