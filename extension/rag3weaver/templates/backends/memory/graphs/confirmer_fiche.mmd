%% tool: confirmer_fiche
%% description: Confirme une fiche proposée, par son uuid (celui que donne la page de survol d'une passe de l'archiviste) : la transition accept, proposed → current, écrite avec la révision lue (l'auteur et la date, l'hôte les pose). Rend {uuid, name, state, revision} de la fiche écrite. Une fiche qui n'est pas proposée, ou un uuid inconnu, est refusé et le dit.
%% param: uuid string! -- L'uuid de la fiche, tel que la page de survol le donne (le nom de son fichier sous fiches/).
%% param: tout json = {} -- Réservé : le filtre vide de la sélection des fiches (le mermaid n'écrit pas d'objet littéral).
%% result: rendu.result

graph LR
    fiches["GraphNode(graph='@builtin:tools/select_structured.mmd', entity='Fiche', filter=$tout, limit=0)"]
    juger["RhaiNode(script_id=gestes_confirmer, inputs='uuid', uuid=$uuid)"]
    lignes["RhaiNode(script='input.lignes')"]
    rendu["RhaiNode(script='input.rendu')"]
    ecrire["ForEachNode(graph='@builtin:backends/memory/graphs/ecrire_fiche.mmd', element='ligne')"]
    fiches -->|result:value| juger
    juger -->|result:value| lignes
    juger -->|result:value| rendu
    lignes -->|result:elements| ecrire
