%% tool: archive_slice
%% description: Files one slice of a conversation in two steps — by run and turn range (the host: the slice is rendered from its Turn rows and kept as its Source) or by contenu (the banc) (18 November 2026, Lucie's form). Step 1, a structured extraction over the whole slice, without the base: the model returns the slice summary, its topics (title, turn ranges, what is said, whether it is still open, free attributes) and the turns set aside. Step 2, one Decide per topic against the recalled fiches, as `archive` does for a section. A turn that no topic covers and no reason sets aside goes to a residual « reste » segment: nothing falls silently. The slice is kept as its Source (L0, written once). Each L1 has the section « turns a-b · <title> ». The report adds `slice_summary` and `open` (the topics still open at the end of the slice) and, with run, `archived_through_turn`: to_turn when the slice is filed without error, from_turn - 1 otherwise (the host files it again). An extraction that is not the requested JSON fails the call, naming response_schema.
%% param: run string = "" -- The run whose turns are filed (the host's call): the slice is rendered from its Turn rows by render_turns, between from_turn and to_turn. Empty: contenu is filed as given (the banc).
%% param: from_turn int = 0 -- The first turn of the slice, included.
%% param: to_turn int = 0 -- The last turn of the slice, included.
%% param: titre string = "" -- The slice title; empty with run: « run <run>, turns <a>-<b> ».
%% param: contenu string = "" -- Without run: the slice, in the single form render_turns gives (one « ## turn <n> » per turn, one « ### <role> · <time> » per message).
%% param: chemin string = "" -- The path of the slice Source; empty with run: sources/<run slug>-turns-<a>-<b>.md.
%% param: origine string = "run_trace" -- The origin of the Source.
%% param: jour string = "" -- The day, AAAA-MM-JJ: only for a default path, which archive_slice always gives.
%% param: candidates int = 5 -- Candidate fiches recalled per topic.
%% param: search_options json = {"limit": 8} -- The options of the candidate search.
%% param: allow_create bool = false -- create allowed (off by default, as in archive).
%% param: context string = "" -- What precedes the slice, shown to the model and never filed.
%% param: context_title string = "Ce qui précède (déjà rangé, ne pas ranger) :" -- The title before context in the step 2 prompt.
%% param: query_chars int = 4000 -- The bound of the candidate search query.
%% param: step2_input string = "both" -- What step 2 reads for a topic: extracted (the extracted « said »), raw_turns (its raw turns) or both.
%% param: raw_turns_max_tokens int = 12000 -- The bound of the raw turns of one topic, in estimated tokens (characters / 4).
%% param: extract_max_tokens int = 8192 -- The output bound of the extraction call.
%% param: trace bool = false -- The report also carries `results`, one entry per topic (as archive).
%% result: done.result

graph LR
    render["GraphNode(graph='@builtin:backends/memory/graphs/render_turns.mmd', run=$run, from_turn=$from_turn, to_turn=$to_turn)"]
    slice["RhaiNode(script_id=archive_slice_input, inputs='run,from_turn,to_turn,titre,contenu,chemin', run=$run, from_turn=$from_turn, to_turn=$to_turn, titre=$titre, contenu=$contenu, chemin=$chemin)"]
    core["ForEachNode(graph='@builtin:backends/memory/graphs/archive_slice_core.mmd', titre=$element.titre, contenu=$element.contenu, chemin=$element.chemin, origine=$origine, jour=$jour, candidates=$candidates, search_options=$search_options, allow_create=$allow_create, context=$context, context_title=$context_title, query_chars=$query_chars, step2_input=$step2_input, raw_turns_max_tokens=$raw_turns_max_tokens, extract_max_tokens=$extract_max_tokens, trace=$trace)"]
    done["RhaiNode(script_id=archive_slice_done, inputs='run,from_turn,to_turn', run=$run, from_turn=$from_turn, to_turn=$to_turn)"]
    render -->|result:value| slice
    slice -->|result:elements| core
    core -->|results:value| done
