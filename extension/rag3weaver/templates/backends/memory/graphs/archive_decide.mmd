%% tool: archive_decide
%% description: Une section (l'élément) : les fiches candidates par la recherche, puis la décision fermée du modèle (une candidate, none, create), rendue comme l'élément des écritures (kind, fiche, records, liens, provenance). Appelé une fois par section par le ForEachNode de archive.
%% Les étiquettes candidate_N sont résolues par archive_decided vers les noms exacts ; les noms et descriptions restent dans le prompt.
%% Le plafond du Decide (max_tokens=4096) : la réponse porte une étiquette, un nom et une phrase, et Gemini 3.x compte sa réflexion dedans ; le défaut de 2048 en tronquait 1 section sur 432 et 1 sur 152 (15 novembre 2026).
%% param: element json! -- La section : {title, level, text, anchor, index, chemin, titre, origine}.
%% param: candidates int = 5 -- Fiches candidates gardées.
%% param: allow_create bool = false -- create permis (éteint par défaut, comme archive).
%% param: instruction string! -- Ce que l'étiquette veut dire, pour le modèle ; sans apostrophe droite (substituée entre apostrophes dans la configuration du Decide ; la typographique ’ passe).
%% param: search_options json! -- Les options de la recherche de candidates (limit…).
%% param: context string = "" -- Ce qui précède, montré au modèle avant la section, jamais rangé (archive, param context).
%% param: context_title string = "Ce qui précède (déjà rangé, ne pas ranger) :" -- Le titre posé devant le contexte (archive, param context_title).
%% param: query_chars int = 4000 -- La borne de la requête de la recherche des candidates (archive, param query_chars).
%% param: proposed json = [] -- Les fiches proposées par les sections précédentes du même document ({name, about, state, via}), portées par le ForEachNode d'archive (carry) : elles ne sont pas encore cherchables, la transaction de l'outil ne les a pas validées.
%% result: decided.result

graph LR
    requete["RhaiNode(script_id=archive_query, inputs='section,query_chars', section=$element, query_chars=$query_chars)"]
    recall["ForEachNode(graph='@graphs/archive_recall.mmd', search_options=$search_options)"]
    prepare["RhaiNode(script_id=archive_candidates, inputs='section,candidates,allow_create,proposed,context,context_title', section=$element, candidates=$candidates, allow_create=$allow_create, proposed=$proposed, context=$context, context_title=$context_title)"]
    decide["Decide(via='llm', labels_from='candidates', labels='none|create', field='prompt', as='verdict', name_as='subject', about_as='subject_about', max_tokens=4096, instruction='$instruction')"]
    decided["RhaiNode(script_id=archive_decided, inputs='allow_create,proposed', allow_create=$allow_create, proposed=$proposed)"]
    requete -->|result:elements| recall
    recall -->|list:value| prepare
    prepare -->|result:element| decide
    decide -->|element:value| decided
