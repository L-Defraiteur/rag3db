%% tool: recall_for_request
%% description: The automatic recall of a turn (the context policy of the code agent, 23 November 2026): for the request of the turn, searches the turns of the windows already summarised (before active_since, never a passage in clear), then the L1 apports, then the cards; fuses them by weighted rank (turns 1.0 × recency, apports 0.85 × recency, cards 0.7 by default) and renders the best passages in full as a block labelled « Rappel automatique », placed last in the context by the host; nothing under the threshold. prepare « direct »: the request as it is, no model call. Returns {block|null, mode, sources, degraded|null, swarm}.
%% param: request string! -- The request of the turn, in full.
%% param: run string = "" -- The run the turns of this conversation are filed under (« <task>:<parent> »); empty: no turn is searched.
%% param: active_since string = "" -- The time (at) of the first line of the oldest window still in clear, ISO 8601: only the turns said before it are searched. Empty: no window is summarised yet, no turn is searched.
%% param: recent json = [] -- The last lines of the conversation ({role, text, at, id}); read by the preparation (prepare « model »), not by « direct ».
%% param: prepare string = "direct" -- « direct »: the request as it is, no model call. « model »: a small local model prepares the search (to come; until then the recall runs direct and says so in degraded).
%% param: author string = "" -- Only what this author wrote: « me » (the agent this call is made for), an agent key, or « * » / empty for every author.
%% param: swarm string = "" -- Only this swarm: « mine », a name, or « * » / empty. Accepted before the swarms exist: it filters nothing, and the answer says swarm null.
%% param: top int = 2 -- How many passages are given in full.
%% param: limit int = 10 -- How many hits each source gives to the fusion.
%% param: weights json = {"turns": 1.0, "apports": 0.85, "cards": 0.7} -- The weight of each source in the fusion.
%% param: recency json = {"turns": 0.15, "apports": 0.1} -- How fast a hit loses weight with its age among the hits of its source (0: no decay).
%% param: min_score float = 0.0 -- A hit whose own search score is under it is not recalled (no recall to fill).
%% param: budget_tokens int = 1500 -- The bound of the block, about 4 characters per token, shared by its passages.
%% result: fuse.result

graph LR
    where["RhaiNode(script_id=recall_where, inputs='request,run,active_since,author,caller,limit,recent', recent=$recent, request=$request, run=$run, active_since=$active_since, author=$author, limit=$limit)"]
    search["ForEachNode(graph='@graphs/recall_search.mmd')"]
    fuse["RhaiNode(script_id=recall_fuse, inputs='prepare,top,weights,recency,min_score,budget_tokens,swarm', prepare=$prepare, top=$top, weights=$weights, recency=$recency, min_score=$min_score, budget_tokens=$budget_tokens, swarm=$swarm)"]
    where -->|result:elements| search
    search -->|list:value| fuse
