%% tool: search_turns
%% description: Searches the words of the indexed turns of the runs (the messages, the tool calls with their params and results), with the same filters as list_turns. Only this tool looks in the turns: the other recalls (recall_fiches, recall_apports…) never return a turn. Returns {turns}, each row a message with its score. Listing by time without words: list_turns.
%% param: query string! -- The words searched.
%% param: run string = "" -- Only this run; empty: all.
%% param: role string = "" -- Only this role (user, assistant, tool); empty: all.
%% param: tool_name string = "" -- Only the calls of this tool; empty: all.
%% param: status string = "" -- Only this status (ok, error, refused, interrupted); empty: all.
%% param: since string = "" -- Only the messages said at or after this time, ISO 8601 (compared on `at`); empty: no bound.
%% param: until string = "" -- Only the messages said at or before this time, ISO 8601; empty: no bound.
%% param: options json = {"limit": 20} -- The options of the search (limit, consistency…); the filters above are added to it.
%% result: found.result

graph LR
    where["RhaiNode(script_id=turns_where, inputs='query,options,run,role,tool_name,status,since,until', query=$query, options=$options, run=$run, role=$role, tool_name=$tool_name, status=$status, since=$since, until=$until)"]
    search["ForEachNode(graph='@graphs/turns_search.mmd')"]
    found["RhaiNode(script_id=turns_found)"]
    where -->|result:elements| search
    search -->|list:value| found
