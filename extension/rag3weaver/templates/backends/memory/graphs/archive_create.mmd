%% graph: archive_create
%% description: Une fiche proposée (state proposed), nommée par le titre de la section, puis l'apport L1 de la section dessus (kind = create). Rend l'élément tel quel pour l'étage des liens.
%% param: element json! -- L'élément décidé (archive_decided) : fiche_record, apport_record, apport_key, links, doc_value…
%% result: out.result

graph LR
    fiche["EntityRecordNode(entity='Fiche', action='put', record=$element.fiche_record)"]
    write["EntityRecordNode(entity='Apport', action='put', record=$element.apport_record)"]
    out["RhaiNode(script_id=archive_pass, inputs='element', element=$element)"]
    fiche -->|record| write
    write -->|record| out
