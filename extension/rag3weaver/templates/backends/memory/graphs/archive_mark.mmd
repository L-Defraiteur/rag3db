%% tool: archive_mark
%% description: Marks a long section for splitting (archive, param segment_over): the section as is, with `long` true when its text is longer than segment_over characters (0: never).
%% param: element json! -- The section.
%% param: segment_over int = 0 -- The threshold in characters; 0: off.
%% result: mark.result

graph LR
    mark["RhaiNode(script='let s = input.section; s.long = input.segment_over > 0 && s.text != () && s.text.len() > input.segment_over; s', inputs='section,segment_over', section=$element, segment_over=$segment_over)"]
