%% tool: archive_segment
%% description: Splits a long section into topics (archive, param segment_over): its numbered paragraphs go to the model, which returns its topics under a schema ({topics: [{title, from, to}]}); each topic becomes a sub-section titled « <title> §from-to » whose text is its paragraphs. A model that does not return this JSON makes the call fail, naming response_schema: nothing is guessed. No topic returned: the section stays whole.
%% param: element json! -- The long section.
%% param: schema json = {"type": "object", "properties": {"topics": {"type": "array", "items": {"type": "object", "properties": {"title": {"type": "string"}, "from": {"type": "integer"}, "to": {"type": "integer"}}, "required": ["title", "from", "to"], "additionalProperties": false}}}, "required": ["topics"], "additionalProperties": false} -- The shape of the model reply.
%% result: build.result

graph LR
    prompt["RhaiNode(script_id=archive_segment_prompt, inputs='section', section=$element)"]
    model["LlmNode(response_schema=$schema, max_tokens=2048, temperature=0)"]
    build["RhaiNode(script_id=archive_segment_build, inputs='section', section=$element)"]
    prompt -->|result:value| model
    model -->|json:value| build
