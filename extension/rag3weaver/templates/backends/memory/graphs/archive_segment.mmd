%% tool: archive_segment
%% description: Découpe une section longue en sujets (archive, param segment_over) : ses paragraphes numérotés vont au modèle, qui rend ses sujets sous un schéma ({topics: [{title, from, to}]}) ; chaque sujet devient une sous-section de titre « <titre> §from-to » et de texte ses paragraphes. Un modèle qui ne rend pas ce JSON fait échouer l’envoi en nommant response_schema : rien n’est deviné. Aucun sujet rendu : la section reste entière.
%% param: element json! -- La section longue.
%% param: schema json = {"type": "object", "properties": {"topics": {"type": "array", "items": {"type": "object", "properties": {"title": {"type": "string"}, "from": {"type": "integer"}, "to": {"type": "integer"}}, "required": ["title", "from", "to"], "additionalProperties": false}}}, "required": ["topics"], "additionalProperties": false} -- La forme de la réponse du modèle.
%% result: build.result

graph LR
    prompt["RhaiNode(script_id=archive_segment_prompt, inputs='section', section=$element)"]
    model["LlmNode(response_schema=$schema, max_tokens=2048, temperature=0)"]
    build["RhaiNode(script_id=archive_segment_build, inputs='section', section=$element)"]
    prompt -->|result:value| model
    model -->|json:value| build
