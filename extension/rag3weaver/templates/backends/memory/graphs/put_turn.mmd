%% tool: put_turn
%% description: Stores one message of a run as a Turn row (the L0 of the archiviste, 18 November 2026): one row per (run, turn, seq), append-only — written again identical, it stays one row and says written false; different, it is refused. Secrets are masked in the text, the params and the result before anything is stored; a tool call's params are bounded at 4000 characters and its result at 8000, the original size said. Returns {written, masked, cut}.
%% param: run string! -- The run: « <chat>:<backend_id> » for a chat, « <task>:<parent> » for a task.
%% param: turn int! -- The turn number, from 1.
%% param: seq int! -- The message number in the turn; 0 is the user message.
%% param: at string! -- When it was said, ISO 8601.
%% param: role string! -- user, assistant or tool.
%% param: text string = "" -- The message.
%% param: tool_name string = "" -- role tool: the tool called.
%% param: params string = "" -- role tool: its arguments, as sent.
%% param: result string = "" -- role tool: its result, as received.
%% param: status string = "ok" -- ok, error, refused or interrupted.
%% param: patterns json = [{"name": "anthropic key", "kind": "prefix", "prefix": "sk-ant-", "min_body": 20}, {"name": "openai project key", "kind": "prefix", "prefix": "sk-proj-", "min_body": 20}, {"name": "openai key", "kind": "prefix", "prefix": "sk-", "min_body": 20}, {"name": "github token", "kind": "prefix", "prefix": "github_pat_", "min_body": 30}, {"name": "github token", "kind": "prefix", "prefix": "ghp_", "min_body": 30}, {"name": "github token", "kind": "prefix", "prefix": "gho_", "min_body": 30}, {"name": "github token", "kind": "prefix", "prefix": "ghu_", "min_body": 30}, {"name": "github token", "kind": "prefix", "prefix": "ghs_", "min_body": 30}, {"name": "github token", "kind": "prefix", "prefix": "ghr_", "min_body": 30}, {"name": "gitlab token", "kind": "prefix", "prefix": "glpat-", "min_body": 20}, {"name": "slack token", "kind": "prefix", "prefix": "xoxb-", "min_body": 20}, {"name": "slack token", "kind": "prefix", "prefix": "xoxp-", "min_body": 20}, {"name": "slack token", "kind": "prefix", "prefix": "xoxa-", "min_body": 20}, {"name": "slack token", "kind": "prefix", "prefix": "xapp-", "min_body": 20}, {"name": "hugging face token", "kind": "prefix", "prefix": "hf_", "min_body": 30}, {"name": "google api key", "kind": "prefix", "prefix": "AIza", "min_body": 30}, {"name": "aws key", "kind": "prefix", "prefix": "AKIA", "min_body": 16}, {"name": "aws key", "kind": "prefix", "prefix": "ASIA", "min_body": 16}, {"name": "google oauth token", "kind": "prefix", "prefix": "ya29.", "min_body": 30}, {"name": "bearer token", "kind": "bearer", "min_body": 16}, {"name": "private key", "kind": "pem"}] -- The secret patterns masked before anything is stored: {name, kind: prefix, prefix, min_body} (a prefix at the start of a word, then a body of at least min_body characters), {name, kind: bearer, min_body}, {name, kind: pem}. Each mask says its name; the first declared pattern that matches wins (a longer prefix before a shorter one).
%% param: record json = {} -- Reserved: the row is composed from the other parameters.
%% result: done.result

graph LR
    compose["RhaiNode(script_id=put_turn_record, inputs='run,turn,seq,at,role,text,tool_name,params,result,status,patterns', patterns=$patterns, run=$run, turn=$turn, seq=$seq, at=$at, role=$role, text=$text, tool_name=$tool_name, params=$params, result=$result, status=$status)"]
    write["EntityRecordNode(entity='Turn', action='put', record=$record)"]
    done["RhaiNode(script_id=put_turn_done)"]
    compose -->|result:record| write
    write -->|record:value| done
