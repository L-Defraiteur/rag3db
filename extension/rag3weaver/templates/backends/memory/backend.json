{
  "version": 1,
  "name": "memory",
  "database": "data/memory.rag3db",
  "embeddings": {
    "address": "",
    "model": "bge-m3",
    "dimensions": 1024
  },
  "vector_extension": "vector",
  "entities": {
    "Memory": {
      "schema": "schemas/memory.json",
      "config": {
        "fields": {
          "claim": {
            "type": "string",
            "isTitle": true
          },
          "why": {
            "type": "string",
            "isContent": true
          },
          "kind": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "reach": {
            "type": "string"
          },
          "state": {
            "type": "string"
          }
        },
        "hashsafe": [
          "claim",
          "reach"
        ],
        "returnFields": [
          "claim",
          "kind",
          "origin",
          "reach",
          "state",
          "revision"
        ],
        "signals": [
          "bm25",
          "vector"
        ],
        "lifecycle": {
          "field": "state",
          "initial": "current",
          "transitions": [
            {
              "name": "review",
              "from": "current",
              "to": "to_review"
            },
            {
              "name": "confirm",
              "from": "to_review",
              "to": "current"
            },
            {
              "name": "supersede",
              "from": "current",
              "to": "superseded"
            },
            {
              "name": "supersede_reviewed",
              "from": "to_review",
              "to": "superseded"
            },
            {
              "name": "set_aside",
              "from": "current",
              "to": "set_aside"
            },
            {
              "name": "set_aside_reviewed",
              "from": "to_review",
              "to": "set_aside"
            }
          ]
        }
      },
      "writes": {
        "created_at": "created_at",
        "updated_at": "updated_at",
        "revision": "revision",
        "transition_dates": [
          {
            "field": "state",
            "to": "to_review",
            "timestamp_field": "reviewed_at"
          }
        ]
      }
    },
    "Subject": {
      "schema": "schemas/subject.json",
      "config": {
        "fields": {
          "name": {
            "type": "string",
            "isTitle": true
          },
          "about": {
            "type": "string",
            "isContent": true
          },
          "state": {
            "type": "string"
          }
        },
        "hashsafe": [
          "name"
        ],
        "returnFields": [
          "name",
          "state",
          "revision"
        ],
        "signals": [
          "bm25",
          "vector"
        ],
        "lifecycle": {
          "field": "state",
          "initial": "current",
          "transitions": [
            {
              "name": "set_aside",
              "from": "current",
              "to": "set_aside"
            }
          ]
        }
      },
      "writes": {
        "created_at": "created_at",
        "updated_at": "updated_at",
        "revision": "revision"
      }
    },
    "Ref": {
      "schema": "schemas/ref.json",
      "config": {
        "fields": {
          "genre": {
            "type": "string"
          },
          "valeur": {
            "type": "string",
            "isTitle": true
          },
          "dit_comme": {
            "type": "string",
            "isContent": true
          },
          "empreinte": {
            "type": "string"
          },
          "etat": {
            "type": "string"
          }
        },
        "hashsafe": [
          "genre",
          "valeur"
        ],
        "returnFields": [
          "genre",
          "valeur",
          "dit_comme",
          "etat",
          "revision"
        ],
        "signals": [
          "bm25"
        ],
        "lifecycle": {
          "field": "etat",
          "initial": "vue",
          "transitions": [
            {
              "name": "revoir",
              "from": "vue",
              "to": "a_revoir"
            },
            {
              "name": "confirmer",
              "from": "a_revoir",
              "to": "vue"
            },
            {
              "name": "perdre",
              "from": "vue",
              "to": "introuvable"
            },
            {
              "name": "perdre_revue",
              "from": "a_revoir",
              "to": "introuvable"
            },
            {
              "name": "retrouver",
              "from": "introuvable",
              "to": "a_revoir"
            },
            {
              "name": "retirer",
              "from": "vue",
              "to": "retiree"
            },
            {
              "name": "retirer_revue",
              "from": "a_revoir",
              "to": "retiree"
            }
          ]
        }
      },
      "writes": {
        "created_at": "created_at",
        "updated_at": "updated_at",
        "revision": "revision"
      }
    },
    "RefType": {
      "schema": "schemas/ref_type.json",
      "config": {
        "fields": {
          "name": {
            "type": "string",
            "isTitle": true
          },
          "description": {
            "type": "string",
            "isContent": true
          },
          "forme": {
            "type": "string"
          },
          "script": {
            "type": "string"
          },
          "etat": {
            "type": "string"
          }
        },
        "hashsafe": [
          "name"
        ],
        "returnFields": [
          "name",
          "description",
          "forme",
          "etat",
          "revision"
        ],
        "signals": [
          "bm25",
          "vector"
        ],
        "lifecycle": {
          "field": "etat",
          "initial": "current",
          "transitions": [
            {
              "name": "retirer",
              "from": "current",
              "to": "retiree"
            }
          ]
        }
      },
      "writes": {
        "created_at": "created_at",
        "updated_at": "updated_at",
        "revision": "revision"
      }
    },
    "Fiche": {
      "schema": "schemas/fiche.json",
      "config": {
        "fields": {
          "name": {
            "type": "string",
            "isTitle": true
          },
          "about": {
            "type": "string",
            "isContent": true
          },
          "state": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "via": {
            "type": "string"
          }
        },
        "hashsafe": [
          "name"
        ],
        "returnFields": [
          "name",
          "about",
          "state",
          "revision",
          "updated_at"
        ],
        "signals": [
          "bm25",
          "vector"
        ],
        "lifecycle": {
          "field": "state",
          "initial": "proposed",
          "transitions": [
            {
              "name": "review",
              "from": "current",
              "to": "to_review"
            },
            {
              "name": "confirm",
              "from": "to_review",
              "to": "current"
            },
            {
              "name": "accept",
              "from": "proposed",
              "to": "current"
            },
            {
              "name": "retire",
              "from": "current",
              "to": "retired"
            },
            {
              "name": "retire_reviewed",
              "from": "to_review",
              "to": "retired"
            },
            {
              "name": "reject",
              "from": "proposed",
              "to": "retired"
            }
          ]
        }
      },
      "writes": {
        "created_at": "created_at",
        "updated_at": "updated_at",
        "revision": "revision"
      }
    },
    "Apport": {
      "schema": "schemas/apport.json",
      "config": {
        "fields": {
          "fiche": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "section": {
            "type": "string",
            "isTitle": true
          },
          "texte": {
            "type": "string",
            "isContent": true
          },
          "niveau": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "via": {
            "type": "string"
          }
        },
        "hashsafe": [
          "fiche",
          "source",
          "section"
        ],
        "returnFields": [
          "fiche",
          "source",
          "section",
          "niveau",
          "state",
          "created_at"
        ],
        "signals": [
          "bm25",
          "vector"
        ],
        "lifecycle": {
          "field": "state",
          "initial": "current",
          "transitions": [
            {
              "name": "consolidate",
              "from": "current",
              "to": "consolidated"
            }
          ]
        }
      },
      "writes": {
        "created_at": "created_at",
        "updated_at": "updated_at",
        "revision": "revision"
      }
    },
    "Etat": {
      "schema": "schemas/etat.json",
      "config": {
        "fields": {
          "fiche": {
            "type": "string",
            "isTitle": true
          },
          "resume": {
            "type": "string",
            "isContent": true
          }
        },
        "hashsafe": [
          "fiche"
        ],
        "returnFields": [
          "fiche",
          "resume",
          "faits",
          "revision",
          "updated_at"
        ],
        "signals": [
          "bm25",
          "vector"
        ]
      },
      "writes": {
        "created_at": "created_at",
        "updated_at": "updated_at",
        "revision": "revision"
      }
    },
    "Source": {
      "schema": "schemas/source.json",
      "config": {
        "fields": {
          "chemin": {
            "type": "string"
          },
          "titre": {
            "type": "string",
            "isTitle": true
          },
          "contenu": {
            "type": "string",
            "isContent": true
          },
          "origine": {
            "type": "string"
          },
          "session": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "via": {
            "type": "string"
          }
        },
        "hashsafe": [
          "chemin"
        ],
        "returnFields": [
          "chemin",
          "titre",
          "origine",
          "session",
          "created_at"
        ],
        "signals": [
          "bm25"
        ]
      },
      "writes": {
        "created_at": "created_at",
        "updated_at": "updated_at",
        "revision": "revision",
        "immutable": true
      }
    },
    "Rangement": {
      "schema": "schemas/rangement.json",
      "config": {
        "fields": {
          "session": {
            "type": "string",
            "isTitle": true
          },
          "transcription": {
            "type": "string",
            "isContent": true
          },
          "motif": {
            "type": "string"
          }
        },
        "hashsafe": [
          "session"
        ],
        "returnFields": [
          "session",
          "transcription",
          "jusqu_a",
          "motif",
          "updated_at"
        ],
        "signals": []
      },
      "writes": {
        "created_at": "created_at",
        "updated_at": "updated_at",
        "revision": "revision"
      }
    }
  },
  "relations": {
    "ANCHORED_TO": {
      "from": "Memory",
      "to": "Subject",
      "from_states": [
        "current",
        "to_review"
      ]
    },
    "REPLACES": {
      "from": "Memory",
      "to": "Memory",
      "from_states": [
        "current"
      ],
      "to_states": [
        "current",
        "to_review"
      ]
    },
    "CITE": {
      "from": "Memory",
      "to": "Ref"
    },
    "ANCRE": {
      "from": "Fiche",
      "to": "Ref",
      "from_states": [
        "current",
        "to_review",
        "proposed"
      ]
    },
    "APPORT": {
      "from": "Fiche",
      "to": "Apport"
    },
    "APPORT_CITE": {
      "from": "Apport",
      "to": "Ref"
    },
    "ETAT_DE": {
      "from": "Etat",
      "to": "Fiche"
    },
    "LIT": {
      "from": "Etat",
      "to": "Apport"
    },
    "CONSOLIDE": {
      "from": "Apport",
      "to": "Apport"
    }
  },
  "tools": {
    "put_memory": {
      "graph": "../notebook/graphs/put.mmd",
      "bindings": {
        "entity": "Memory"
      },
      "input_payloads": {
        "record": {
          "entity": "Memory",
          "view": "editable"
        }
      }
    },
    "get_memory": {
      "graph": "../notebook/graphs/get.mmd",
      "bindings": {
        "entity": "Memory"
      },
      "input_payloads": {
        "record": {
          "entity": "Memory",
          "view": "identity"
        }
      }
    },
    "put_subject": {
      "graph": "../notebook/graphs/put.mmd",
      "bindings": {
        "entity": "Subject"
      },
      "input_payloads": {
        "record": {
          "entity": "Subject",
          "view": "editable"
        }
      }
    },
    "anchor": {
      "graph": "../../tools/link.mmd",
      "bindings": {
        "relation": "ANCHORED_TO"
      },
      "description": "Ancre des mémoires à des sujets : chaque lien donne la mémoire par {claim, reach} et le sujet par {name}. Une mémoire ancrée repasse « à revoir » quand son sujet change. Seule une mémoire courante ou à revoir s'ancre. Les deux bouts se cherchent dans la cellule de la session ; pour un sujet d'une autre cellule (un sujet global), ajoute au lien \"to_cell\": {\"org\": …, \"project\": …}."
    },
    "supersede_link": {
      "graph": "../../tools/link.mmd",
      "bindings": {
        "relation": "REPLACES"
      },
      "description": "Dit qu'une mémoire en remplace une autre : from est la nouvelle, to l'ancienne, chacune par {claim, reach}. La nouvelle doit être courante, l'ancienne courante ou à revoir. Le lien ne change pas l'état de l'ancienne : passe-la ensuite à « superseded » par put_memory."
    },
    "recall": {
      "graph": "../../tools/search_structured.mmd",
      "bindings": {
        "target": "Memory"
      },
      "metadata": [
        {
          "node": "render",
          "port": "meta"
        }
      ]
    },
    "recall_subjects": {
      "graph": "../../tools/search_structured.mmd",
      "bindings": {
        "target": "Subject"
      },
      "metadata": [
        {
          "node": "render",
          "port": "meta"
        }
      ]
    },
    "add_ref": {
      "graph": "graphs/add_ref.mmd",
      "bindings": {
        "refs_entity": "Ref",
        "types_entity": "RefType",
        "from_entity": "Memory",
        "relation": "CITE"
      }
    },
    "create_ref_type": {
      "graph": "graphs/create_ref_type.mmd",
      "bindings": {
        "types_entity": "RefType"
      }
    },
    "put_fiche": {
      "graph": "../notebook/graphs/put.mmd",
      "bindings": {
        "entity": "Fiche"
      },
      "input_payloads": {
        "record": {
          "entity": "Fiche",
          "view": "editable"
        }
      }
    },
    "get_fiche": {
      "graph": "../notebook/graphs/get.mmd",
      "bindings": {
        "entity": "Fiche"
      },
      "input_payloads": {
        "record": {
          "entity": "Fiche",
          "view": "identity"
        }
      }
    },
    "put_source": {
      "graph": "../notebook/graphs/put.mmd",
      "bindings": {
        "entity": "Source"
      },
      "input_payloads": {
        "record": {
          "entity": "Source",
          "view": "editable"
        }
      }
    },
    "put_apport": {
      "graph": "../notebook/graphs/put.mmd",
      "bindings": {
        "entity": "Apport"
      },
      "input_payloads": {
        "record": {
          "entity": "Apport",
          "view": "editable"
        }
      }
    },
    "get_apport": {
      "graph": "../notebook/graphs/get.mmd",
      "bindings": {
        "entity": "Apport"
      },
      "input_payloads": {
        "record": {
          "entity": "Apport",
          "view": "identity"
        }
      }
    },
    "relier_apport": {
      "graph": "../../tools/link.mmd",
      "bindings": {
        "relation": "APPORT"
      },
      "description": "Range un apport (L1) sur sa fiche : chaque lien donne la fiche par {name} et l'apport par {fiche, source, section}."
    },
    "ancrer_fiche": {
      "graph": "graphs/add_ref.mmd",
      "bindings": {
        "refs_entity": "Ref",
        "types_entity": "RefType",
        "from_entity": "Fiche",
        "relation": "ANCRE"
      },
      "description": "Ancre une fiche (un sujet) à une chose citée — un chemin, un symbole, une ligne : la Ref par son genre et sa valeur, la fiche par {name}."
    },
    "citer_source": {
      "graph": "graphs/add_ref.mmd",
      "bindings": {
        "refs_entity": "Ref",
        "types_entity": "RefType",
        "from_entity": "Apport",
        "relation": "APPORT_CITE"
      },
      "description": "Pose la provenance d'un apport : une Ref de genre doc, valeur <chemin du source>#<titre de la section>, l'apport par {fiche, source, section}."
    },
    "recall_fiches": {
      "graph": "../../tools/search_structured.mmd",
      "bindings": {
        "target": "Fiche"
      },
      "metadata": [
        {
          "node": "render",
          "port": "meta"
        }
      ]
    },
    "recall_apports": {
      "graph": "../../tools/search_structured.mmd",
      "bindings": {
        "target": "Apport"
      },
      "metadata": [
        {
          "node": "render",
          "port": "meta"
        }
      ]
    }
  },
  "reactions": {
    "review_anchored": {
      "graph": "graphs/review_anchored.mmd",
      "bindings": {
        "target": "Memory",
        "relation": "ANCHORED_TO",
        "transition": "review",
        "source": "Subject"
      },
      "description": "Un sujet qui change fait repasser « à revoir » les mémoires qui l'ancrent."
    }
  }
}
