{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "key",
    "run",
    "turn",
    "seq",
    "at",
    "role",
    "text",
    "status",
    "masked",
    "cut",
    "revision",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1,
      "description": "<run>#<turn>#<seq>: the identity of the row."
    },
    "run": {
      "type": "string",
      "minLength": 1,
      "description": "The run: « <chat>:<backend_id> » for a chat, « <task>:<parent> » for a task."
    },
    "turn": {
      "type": "integer",
      "minimum": 1,
      "description": "The turn number in the run, from 1."
    },
    "seq": {
      "type": "integer",
      "minimum": 0,
      "description": "The message number in the turn; 0 is the user message."
    },
    "at": {
      "type": "string",
      "description": "When the message was said, ISO 8601."
    },
    "role": {
      "type": "string",
      "enum": ["user", "assistant", "tool"]
    },
    "text": {
      "type": "string",
      "description": "The message, secrets masked."
    },
    "tool_name": {
      "type": "string",
      "description": "role tool: the tool called."
    },
    "params": {
      "type": "string",
      "description": "role tool: its arguments, secrets masked, bounded at 4000 characters."
    },
    "result": {
      "type": "string",
      "description": "role tool: its result, secrets masked, bounded at 8000 characters (« … (<n> characters) » says the original size)."
    },
    "status": {
      "type": "string",
      "enum": ["ok", "error", "refused", "interrupted"]
    },
    "masked": {
      "type": "integer",
      "minimum": 0,
      "description": "How many secrets were masked in this message."
    },
    "cut": {
      "type": "boolean",
      "description": "Whether params or result was bounded."
    },
    "section": {
      "type": "string",
      "description": "turn <n>: the heading of this turn in its slice."
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "integer",
      "description": "Server UTC epoch milliseconds"
    },
    "updated_at": {
      "type": "integer",
      "description": "Server UTC epoch milliseconds"
    }
  }
}
