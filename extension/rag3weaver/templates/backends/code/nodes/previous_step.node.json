{
  "name": "PreviousStep",
  "description": "Le bloc « Previous step » de l'équipier : ce que le pas d'avant a lu, écrit et lancé, les faits que l'index lui a rendus (« nom — chemin:ligne »), et son dernier texte, borné en caractères. Déclaré par teammate.carry_over_node ; le bloc Rust prend la main si le script échoue.",
  "script": "previous_step.ts",
  "inputs": {
    "work": {
      "schema": {
        "type": "object",
        "required": [
          "number",
          "read",
          "wrote",
          "last_text",
          "budget"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 0
          },
          "read": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "wrote": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "command": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "required": [
                  "command",
                  "output"
                ],
                "properties": {
                  "command": {
                    "type": "string"
                  },
                  "output": {
                    "type": "string"
                  }
                }
              }
            ]
          },
          "last_text": {
            "type": "string"
          },
          "budget": {
            "type": "integer",
            "minimum": 0
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "tool",
                "result"
              ],
              "properties": {
                "tool": {
                  "type": "string"
                },
                "result": {
                  "type": "string"
                }
              }
            }
          },
          "previous_block": {
            "type": "string"
          }
        }
      },
      "required": true
    }
  },
  "outputs": {
    "block": {
      "schema": {
        "type": "string"
      }
    }
  },
  "config": {
    "style": {
      "schema": {
        "enum": [
          "full",
          "compact"
        ]
      },
      "default": "full",
      "description": "full : le bloc du Rust, à l'octet près ; compact : sans la fin de sortie de la dernière commande."
    },
    "fact_tools": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "default": [
        "search_code",
        "usages",
        "callees",
        "impact",
        "outline",
        "grep_files"
      ],
      "description": "Les outils dont les résultats donnent des faits à garder : leurs lignes « chemin:ligne »."
    },
    "max_facts": {
      "schema": {
        "type": "integer",
        "minimum": 0
      },
      "default": 40,
      "description": "Le nombre de lignes de faits gardées."
    },
    "max_facts_per_file": {
      "schema": {
        "type": "integer",
        "minimum": 1
      },
      "default": 12,
      "description": "Le nombre de lignes de faits gardées pour un même fichier : chaque fichier cartographié garde sa part."
    }
  }
}
