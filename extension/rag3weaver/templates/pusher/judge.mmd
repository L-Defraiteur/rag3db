%% tool: lot_judge
%% description: The lot judge (24 November 2026): reads a lot's diff, AGENTS.md and the judge's rules (templates/pusher/judge_rules.json), and gives findings {rule, file, line, excerpt, severity, why} and a summary. An opinion: it blocks nothing. The model comes from the registry the pusher gives (the llm service); the graph names none.
%% param: diff json! -- The lot's diff, origin/master...head, as a JSON string.
%% param: rules json! -- {agents_md: the text of AGENTS.md, rules: the rules of judge_rules.json}.
%% param: instruction string = "Read the rules, then the diff. Report every added line that violates a rule, with its file, line and excerpt; report nothing that is not in an added line. When the lot is clean, give no finding." -- The task line, set before the rules and the diff; the meaning of each field is in the schema's descriptions.
%% param: schema json = {"type": "object", "additionalProperties": false, "required": ["findings", "summary"], "properties": {"findings": {"type": "array", "description": "Every violation found in the diff's added lines, one per place; none when the lot is clean. Never a finding without its file and its excerpt.", "items": {"type": "object", "additionalProperties": false, "required": ["rule", "file", "line", "excerpt", "severity", "why"], "properties": {"rule": {"type": "string", "description": "The id of the rule violated, from the rules given."}, "file": {"type": "string", "description": "The file of the diff, as its header names it."}, "line": {"type": "integer", "description": "The line in the new file, read from the hunk header; 0 when it cannot be read."}, "excerpt": {"type": "string", "description": "The added line, or the shortest part of it that shows the violation, copied as it is."}, "severity": {"type": "string", "enum": ["high", "medium", "low"], "description": "The rule's severity, lowered when the case is borderline."}, "why": {"type": "string", "description": "One sentence: what the line does against the rule, and what the rule would have it be."}}}}, "summary": {"type": "string", "description": "One sentence: how many findings, and the most serious one; or that the lot is clean."}}} -- The shape of the report.
%% result: model.json

graph LR
    rules["RhaiNode(script='input', value=$rules)"]
    diff["RhaiNode(script='input', value=$diff)"]
    parts["Collect(inputs='rules,diff')"]
    model["LlmNode(instruction=$instruction, response_schema=$schema, max_tokens=16384)"]
    rules -->|result:rules| parts
    diff -->|result:diff| parts
    parts -->|list:context| model
