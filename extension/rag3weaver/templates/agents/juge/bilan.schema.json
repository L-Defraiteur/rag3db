{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resume",
    "note",
    "confiance",
    "objectif",
    "faits",
    "frictions",
    "attentes",
    "comparaison",
    "renvois_bloquants"
  ],
  "properties": {
    "resume": {
      "type": "string",
      "description": "Le jugement en deux phrases."
    },
    "note": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "confiance": {
      "type": "string",
      "enum": [
        "faible",
        "moyenne",
        "haute"
      ]
    },
    "objectif": {
      "type": "string",
      "enum": [
        "atteint",
        "partiel",
        "non"
      ]
    },
    "faits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "texte",
          "nature"
        ],
        "properties": {
          "texte": {
            "type": "string"
          },
          "nature": {
            "type": "string",
            "enum": [
              "dit",
              "deduit"
            ]
          }
        }
      }
    },
    "frictions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Reformulations, questions redemandées, boucles, action annoncée sans outil."
    },
    "attentes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Appels lents, reprises."
    },
    "comparaison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verdict",
        "sur"
      ],
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "premier",
            "amelioration",
            "regression",
            "pareil"
          ]
        },
        "sur": {
          "type": "string",
          "description": "Sur quoi, au regard des bilans précédents de la même tâche."
        }
      }
    },
    "renvois_bloquants": {
      "type": "array",
      "description": "Les défauts bloquants des outils appelés, par outil et genre, sans les redire.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "outil",
          "genre"
        ],
        "properties": {
          "outil": {
            "type": "string"
          },
          "genre": {
            "type": "string",
            "enum": [
              "parametre_manquant",
              "parametre_mal_nomme",
              "parametre_devrait_etre_optionnel",
              "parametre_devrait_etre_obligatoire",
              "format_de_parametre",
              "retour_mal_forme",
              "retour_incoherent",
              "retour_bavard",
              "retour_hors_sujet",
              "retour_incomplet_ou_ambigu",
              "description_trompeuse",
              "erreur_muette",
              "outil_manquant",
              "outils_a_fondre",
              "autre"
            ]
          }
        }
      }
    }
  }
}