%% Template: la forme du graphe stratégie — recherche + expansion de graphe
%% Variables: $kb_name, $query, $relation, $direction, $limit
%%
%% **Une seule écriture.** `Catalog::build_dataflow_graph` instancie ce
%% gabarit (placeholders, puis les vraies valeurs posées en config JSON) au
%% lieu de redire ces nœuds en Rust — c'étaient trois écritures du même
%% graphe jusqu'au 18 septembre 2026 au soir. Sans expansion, le tronçon
%% `fetch_related_0`/`compose` est retiré à l'instanciation ; une règle de
%% plus est un clone de `fetch_related_0`.

graph LR
    query_source["KBQuerySourceNode(kb_name='$kb_name', query='$query')"]
    primary_search["KBSearchNode"]
    fetch_related_0["FetchRelatedNode(relation='$relation', direction='$direction', limit=$limit)"]
    compose["ComposeNode"]

    query_source -->|query| primary_search
    primary_search -->|results| fetch_related_0
    primary_search -->|results| compose
    fetch_related_0 -->|children| compose
