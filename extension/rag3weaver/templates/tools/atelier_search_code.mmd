%% tool: search_code
%% description: Chercher dans le code, par mots et par sens — à prendre d'abord. L'outil choisit seul : l'index quand il est prêt, le balayage des fichiers (mots exacts) quand rien n'est indexé ; la réponse dit d'où elle vient. grep ne sert que pour un motif littéral exact.
%% param: context json! -- Contexte explicite : target {kind: backend, id: identifiant du dépôt attaché}. Une vue indisponible est refusée.
%% param: query string! -- Description naturelle, nom, identifiant.
%% param: options json! -- SearchOptions : filter_condition, limit, offset, signals, consistency, rerank, highlights. highlights « sparse » ajoute aux morceaux sans surlignage lucivy des passages à surligner (environ 300 ms, utile seulement à qui affiche les morceaux). rerank {"candidates": 20} fait relire les 20 premiers résultats par un cross-encoder (une vraie question en langue naturelle ; inutile sur un identifiant) ; sans relecteur configuré, la réponse le dit. Pendant une réindexation, consistency « eventual » (défaut) répond sur l'état validé d'avant sans l'attendre, et peut ne pas voir vos propres écritures en file ; « strict » l'attend.
%% param: scope string = "" -- Borner la réponse à ces chemins relatifs à la racine, séparés par | (src/|test/) ; vide : tout l'index. Composé avec le filtre des options.
%% param: language string = "" -- Borner la réponse à ces langages, séparés par | (cpp|rust) ; vide : tous.
%% param: mode string = "auto" -- auto (l'état de l'index décide), indexed (toujours l'index), scan (toujours le balayage).
%% result: invoke.results

graph LR
    invoke["InvokeToolNode(operation='search_code', context=$context, arguments={"query":"$query","options":"$options","scope":"$scope","language":"$language","mode":"$mode"})"]
