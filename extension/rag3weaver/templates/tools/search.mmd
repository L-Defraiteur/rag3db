%% tool: search
%% description: Cherche dans une entité ou une base de connaissances et rend les résultats, les chunks trouvés étant résolus vers leur entité parente.
%% param: target string! -- Nom de l'entité ou de la base de connaissances où chercher (ex. 'Product').
%% param: query string! -- Texte de la requête, en langue naturelle.
%% param: limit int = 10 -- Nombre maximum de résultats.
%% choices: target = @targets
%% result: resolve.results
%%
%% Trois nœuds, dont deux que le modèle n'a pas à connaître : la fiche
%% ci-dessus est toute la surface. `fuzzy_distance`, `result_mode` et les
%% `return_fields` de la résolution restent en dedans.

graph LR
    source["SearchSourceNode(target_name=$target, query=$query)"]
    bm25["BM25SearchNode(limit=$limit)"]
    resolve["ResolveParentNode"]

    source -->|query| bm25
    source -->|query| resolve
    bm25 -->|results| resolve
