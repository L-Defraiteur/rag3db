%% tool: impact
%% description: Ce qu'une modification de ce nom peut toucher, AVANT d'éditer : le code qui en dépend, directement puis à deux ou trois sauts, et les tests qui le traversent — nommés, avec leur fichier, prêts à être rejoués. Un utilitaire appelé de partout est montré mais pas traversé. Un nom défini plusieurs fois part de toutes ses définitions ; `path` restreint celles qu'on regarde.
%% param: name string! -- Le nom de la fonction, du type ou de la méthode qu'on va modifier.
%% param: path string = "" -- Ne partir que des définitions sous ce chemin (préfixe de fichier).
%% param: depth int = 2 -- Sauts suivis, de 1 à 3.
%% param: budget int = 200 -- Nœuds rendus au plus ; au-delà, ils sont comptés.
%% param: include_by_name bool = false -- Montrer aussi les usages trouvés par le nom seul (un nom défini plusieurs fois, usage attribué à aucune définition) ; par défaut ils sont comptés, pas listés.
%% result: impact.result

graph LR
    impact["NeighborhoodNode(pivot=Symbol, key=name, defined_by=DEFINES, used_by=MENTIONS, relations='CONSUMES|INHERITS_FROM|IMPLEMENTS', direction=incoming, group_by=test_role, label_field=test_name, note_field=test_certainty, also_path='HAS_PARENT>|IMPLEMENTS>|PARENT_OF>', also_same=name, also_label='Par le trait (peut-être) : ce qui appelle la méthode du trait que cette méthode implémente', group_title='Tests qui la traversent', rest_title='Code qui en dépend', title=name, kind_field=scope_type, path_fields='repo_path|file_path', line_field=start_line, name=$name, path=$path, depth=$depth, budget=$budget, include_by_name=$include_by_name, max_degree=50, edge_field=resolution, edge_guessed=nom, collect='LOCKS>', collect_field=name, collect_note=usage, collect_title='Verrous pris sur le chemin')"]

%% Le schéma de code (src/code.rs) : les `CONSUMES`, `INHERITS_FROM` et
%% `IMPLEMENTS` **entrants** — qui consomme, qui hérite, qui implémente —,
%% et `test_role` / `test_name` / `test_certainty` sur `Scope` (codeparsers,
%% marque de test). Le départ supplémentaire : la méthode modifiée → son
%% bloc `impl` (`HAS_PARENT`) → le trait qu'il implémente (`IMPLEMENTS`) → la
%% méthode du trait du même nom (`PARENT_OF`) ; ce qui l'appelle peut
%% atteindre la méthode modifiée par un `dyn Trait`. Le nœud est générique :
%% il ne sait rien de ces relations.
%% Les arêtes devinées (`resolution = nom`) ne sont pas suivies ; une arête
%% sans marque (base d'avant la colonne) l'est. Allumé le 4 octobre 2026,
%% quand le banc des relations a tenu : « relie » 1,00, « tests traversés »
%% 0,89 / 0,99, une fois typés les receveurs (macros, `self`, chaînes std,
%% champs, retours, motifs `Some` / `Ok` — codeparsers 4abafd2).
%% **Les usages par le nom seul** (nom ambigu, attribués à aucune définition)
%% sont comptés en une ligne, pas listés : deux appelants sûrs ne se noient
%% plus dans trente homonymes (`NodeTable::update`, 11 oct. 2026) ;
%% `include_by_name` les montre.
%% **Les verrous pris sur le chemin** (`collect='LOCKS>'`) : pour la méthode
%% modifiée et chaque scope qui en dépend, les verrous qu'il prend : un
%% mutex (`Classe::champ`, exclusif ou partagé) ou une fonction de verrou
%% déclarée par le dépôt (`workspace.locks_via`) — où chercher qui tient un
%% verrou avant d'appeler ce qu'on va changer.
