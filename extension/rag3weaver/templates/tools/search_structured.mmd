%% tool: search_structured
%% description: Recherche structurée dans une entité : lucivy et dense local, filtres appliqués par chaque signal avant fusion et pagination.
%% param: target string! -- Entité où chercher.
%% param: query string! -- Description naturelle ou nom de carte.
%% param: options json! -- SearchOptions : filter_condition, limit, offset, signals, consistency. Les restrictions collection/deck sont injectées ici avant l'exécution.
%% result: render.results

graph LR
    source["SearchSourceNode(target_name=$target, query=$query, options=$options)"]
    bm25["BM25SearchNode"]
    vector["VectorSearchNode"]
    sparse["SparseSearchNode"]
    fuse["FuseResultsNode(default_weights='bm25:0.45,vector:0.55,sparse:0.4')"]
    paginate["PaginateNode"]
    resolve["ResolveParentNode"]
    render["RenderResultsNode"]
    source -->|query| bm25
    source -->|query| vector
    source -->|query| sparse
    source -->|query| fuse
    source -->|query| paginate
    source -->|query| resolve
    source -->|query| render
    source -->|meta| render
    bm25 -->|meta| render
    vector -->|meta| render
    sparse -->|meta| render
    bm25 -->|results:bm25| fuse
    vector -->|results:vector| fuse
    sparse -->|results:sparse| fuse
    fuse -->|results| paginate
    paginate -->|results| resolve
    resolve -->|results| render
