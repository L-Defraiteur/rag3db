%% tool: search_structured
%% description: Recherche structurée dans une entité : lucivy et dense local, filtres appliqués par chaque signal avant fusion et pagination.
%% param: target string! -- Entité où chercher.
%% param: query string! -- Description naturelle ou nom de carte. Du texte seulement : aucun caractère n'y est un opérateur (-, --, +, guillemets, AND/OR, parenthèses sont cherchés tels quels).
%% param: options json = {} -- SearchOptions : filter_condition, limit, offset, signals, consistency. Les restrictions collection/deck sont injectées ici avant l'exécution.
%% param: default_filter json = {} -- Un filtre que l'outil pose par défaut (sa liaison au manifeste) : il ne vaut que si options n'a pas de filter_condition ; un filter_condition explicite, même {}, le remplace.
%% param: exclude json = [] -- Écarter les résultats dont le texte contient l'un de ces mots (liste, ["test"]) ; sans tenir compte de la casse, sauf exact. Avant la limite, pour chaque signal.
%% param: must json = [] -- Ne garder que les résultats dont le texte contient chacun de ces mots (liste) ; sans tenir compte de la casse, sauf exact.
%% param: phrase json = [] -- Ne garder que les résultats dont le texte contient chacune de ces phrases, telles quelles (liste) ; sans tenir compte de la casse, sauf exact.
%% param: exact bool = false -- true : exclude, must et phrase tiennent compte de la casse.
%% result: render.results

graph LR
    source["SearchSourceNode(target_name=$target, query=$query, options=$options, default_filter=$default_filter, exclude=$exclude, must=$must, phrase=$phrase, exact=$exact)"]
    bm25["BM25SearchNode"]
    vector["VectorSearchNode"]
    sparse["SparseSearchNode"]
    fuse["FuseResultsNode(default_weights='bm25:0.45,vector:0.55,sparse:0.4')"]
    paginate["PaginateNode"]
    resolve["ResolveParentNode"]
    render["RenderResultsNode"]
    source -->|query| bm25
    source -->|query| vector
    source -->|query| sparse
    source -->|query| fuse
    source -->|query| paginate
    source -->|query| resolve
    source -->|query| render
    source -->|meta| render
    bm25 -->|meta| render
    vector -->|meta| render
    sparse -->|meta| render
    bm25 -->|results:bm25| fuse
    bm25 -->|status| fuse
    vector -->|results:vector| fuse
    vector -->|status| fuse
    sparse -->|results:sparse| fuse
    sparse -->|status| fuse
    fuse -->|results| paginate
    paginate -->|results| resolve
    resolve -->|results| render
