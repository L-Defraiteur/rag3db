%% tool: navigate_symbols
%% description: Navigation bornée dans les symboles d'un dépôt attaché : arbre, plages parentes/enfants et membres partiels, avec UUID et fraîcheur. Même contrat que l'outil du dépôt ; aucun parent inventé ni réindexation implicite.
%% param: context json! -- Contexte explicite target {kind: backend, id: identifiant du dépôt attaché}. Vue indisponible refusée.
%% param: path string! -- Chemin relatif exact du fichier indexé.
%% param: source string = "" -- Source de l'index ; vide refuse les sources ambiguës.
%% param: mode string = "file" -- file : racine fichier ; parents/children : plages depuis symbole ; members : faits partiels déclarés, pas héritage.
%% choices: mode = file | parents | children | members
%% param: symbol string = "" -- UUID ou nom exact dans path/source ; requis hors mode file. Homonymes rendus sans choix arbitraire.
%% param: depth int = 2 -- Nombre d'arêtes depuis la racine (0=racine,1=voisins), plafond16 ; pour members,0=racine,positif=faits directs.
%% param: limit int = 80 -- Nœuds et faits rendus (1..200), budget96Kio ; entrée plafonnée2000 scopes sinon navigation indisponible.
%% param: format string = "markdown" -- markdown compact ou json structuré avec références/provenance/limites/fraîcheur.
%% choices: format = markdown | json
%% result: invoke.results

graph LR
    invoke["InvokeToolNode(operation='navigate_symbols', context=$context, arguments={"path":"$path","source":"$source","mode":"$mode","symbol":"$symbol","depth":"$depth","limit":"$limit","format":"$format"})"]
