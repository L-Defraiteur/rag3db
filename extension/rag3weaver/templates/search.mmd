%% Template: Basic search pipeline
%% Variables: $kb_name, $query
%%
%% KBQuerySourceNode emits the search query,
%% KBSearchNode executes it via Catalog::rechercher().
%% Outputs: ps.results (Vec<UnifiedResult>), ps.meta (SearchMeta)

graph LR
    qs["KBQuerySourceNode(kb_name='$kb_name', query='$query')"]
    ps["KBSearchNode"]

    qs -->|query| ps
