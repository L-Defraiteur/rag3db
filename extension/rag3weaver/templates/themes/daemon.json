{
  "nom": "daemon",
  "couleurs": {
    "fond": "#050505",
    "texte": "#ff3333",
    "halo": [
      "#ff0000",
      "#8b0000"
    ],
    "sourdine": "#666666"
  },
  "police": "'Courier New', Courier, monospace",
  "animations": {
    "reflechit": {
      "forme": "cercle",
      "ms": 150,
      "glyphes": [
        "᚛",
        "ᚨ",
        "ᛒ",
        "ᛟ",
        "᚜",
        "⸸",
        "‡"
      ],
      "coeur": "⛧",
      "gabarits": [
        "⟪ {gauche} {coeur} {droite} ⟫ INVOCATION DU CODE..."
      ]
    },
    "lit": {
      "forme": "transmutation",
      "ms": 200,
      "glyphes": [
        "⍟",
        "🜂",
        "☿",
        "☉",
        "♄",
        "🜄",
        "∮"
      ],
      "coeur": "⸸",
      "gabarits": [
        "⁅ {coeur} ⁆—[ {s} ]—⁅ {coeur} ⁆ ANALYSE EN COURS..."
      ]
    },
    "ecrit": {
      "forme": "glitch",
      "ms": 100,
      "glyphes": [
        "∇",
        "∫",
        "∃",
        "∀",
        "∴",
        "∵",
        "⊕",
        "⊗",
        "⌇"
      ],
      "coeur": "⛧",
      "gabarits": [
        "[{a} {coeur} {b}] ...COMPILING CURSE...",
        "❬{a}{b} {coeur} {c}❭ ...SUMMONING COMPILER...",
        " {a} ⸢{coeur}⸣ {b}  ...PARSING SOULS..."
      ]
    }
  },
  "replis": {
    "🜂": "△",
    "🜄": "▽"
  },
  "ascii": {
    "coeur": "*",
    "glyphes": [
      "|",
      "/",
      "-",
      "\\"
    ],
    "cadre": {
      "⟪": "<<",
      "⟫": ">>",
      "⁅": "[",
      "⁆": "]",
      "—": "-",
      "⸢": "[",
      "⸣": "]",
      "❬": "<",
      "❭": ">",
      "⸸": "+"
    }
  },
  "code": {
    "keyword": "#ff3333",
    "type": "#ff7a45",
    "function": "#ffb347",
    "string": "#c9a66b",
    "comment": "#6b5a5a",
    "number": "#ff9e64",
    "constant": "#ff9e64",
    "variable": "#e8d5d5",
    "property": "#d9a0a0",
    "operator": "#ff5555",
    "punctuation": "#8a7a7a",
    "attribute": "#b85d5d",
    "label": "#b85d5d",
    "module": "#b85d5d",
    "other": "#d8c8c8",
    "en_ligne": "#ff9e64",
    "cadre": "#666666"
  }
