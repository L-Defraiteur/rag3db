+};
+RAG3DB_API thread_local TraqueCtx traqueCtx{};
+RAG3DB_API TraqueCtx& traqueGet() {
+    return traqueCtx;
+}
+struct TraqueSlot {
+    std::atomic<const void*> buf{nullptr};
+    std::atomic<long> tid{0};
+};
+static TraqueSlot traqueSlots[4096];
+RAG3DB_API long traqueTid() {
+    static thread_local long t = syscall(SYS_gettid);
+    return t;
+}
+static std::atomic<int> traqueReported{0};
+RAG3DB_API void traqueReport(const char* why) {
+    auto& c = traqueCtx;
+    static const char* names[24] = {"reserve.length", "startOffset", "dest", "vec", "buf",
+        "nblocks", "blk.data", "blk.size", "blk.offsetApres", "data.numValues", "data.startPage",
+        "data.numPages", "dict.pos", "dict.nOffsets", "dict.first", "dict.start", "dict.end",
+        "data.nvpp", "boucle.result", "boucle.length", "boucle.scanned", "boucle.inPage",
+        "boucle.pageIdx", "offsets.numValues"};
+    fprintf(stderr, "TRAQUE %s tid=%ld", why, traqueTid());
+    for (auto i = 0; i < 24; i++) {
+        fprintf(stderr, " %s=%#lx", names[i], c.v[i]);
+    }
+    fprintf(stderr, "\n");
+    fflush(stderr);
+    if (traqueReported.exchange(1) == 0) {
+        prctl(PR_SET_PTRACER, PR_SET_PTRACER_ANY, 0, 0, 0);
+        char cmd[512];
+        snprintf(cmd, sizeof(cmd),
+            "env -u LD_PRELOAD -u LD_LIBRARY_PATH gdb -p %d -batch -ex 'set pagination off' -ex "
+            "'thread apply all bt 30' > /home/lucied/.cache/rag3db-moteur-notes/asan/fils-%d.txt "
+            "2>&1",
+            getpid(), getpid());
+        [[maybe_unused]] auto r = system(cmd);
+    }
+}
+struct RAG3DB_API TraqueHold {
+    TraqueSlot& s;
+    const void* prevBuf;
+    long prevTid;
+    TraqueHold(const void* b, const char* where) : s{traqueSlots[((uintptr_t)b >> 4) % 4096]} {
+        prevBuf = s.buf.load();
+        prevTid = s.tid.load();
+        if (prevBuf == b && prevTid != 0 && prevTid != traqueTid()) {
+            fprintf(stderr, "TRAQUE CONCURRENT buf=%p ou=%s moi=%ld autre=%ld\n", b, where,
+                traqueTid(), prevTid);
+            traqueReport("concurrent");
+        }
+        s.tid.store(traqueTid());
+        s.buf.store(b);
+    }
+    ~TraqueHold() {
+        // Ne restaure que sa propre imbrication ; sinon vide (pas d'entrée périmée d'un autre fil).
+        if (prevTid == traqueTid()) {
+            s.tid.store(prevTid);
+            s.buf.store(prevBuf);
+        } else {
+            s.buf.store(nullptr);
+            s.tid.store(0);
+        }
+    }
+};
+RAG3DB_API void* traqueHoldNew(const void* b, const char* where) {
+    return new TraqueHold(b, where);
+}
+RAG3DB_API void traqueHoldDelete(void* h) {
+    delete static_cast<TraqueHold*>(h);
+}
+static void traqueAsan(const char*) {
+    traqueReport("asan");
+}
+static int traqueInstall = (__asan_set_error_report_callback(traqueAsan), 0);
