From ca25dd874fd60dce9d656d99e81b06ac398825e1 Mon Sep 17 00:00:00 2001
From: Lucie Defraiteur <luciedefraiteur@gmail.com>
Date: Sat, 3 Oct 2026 14:23:54 +0200
Subject: [PATCH 4/4] fix(cubecl-fusion): number F32 and Flex32 locals
 together, they share one registry
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The generated kernel keeps F32 and Flex32 block locals in the same l_f32
registry (codegen/io.rs), but LocalVariablePool numbered each declared
precision on its own: a Flex32 local and an F32 local could get the same
position and overwrite each other. It happens as soon as a fused kernel
casts Flex32 to F32 mid-chain — hard_sigmoid on a Flex32 tensor computes
in F32 — and the overwritten local is an input still to be read.

The pool is now keyed by storage precision (Flex32 maps to F32) and keeps
the declared precision next to each position.
---
 .../tests/fusion/flex32_locals.rs             |  32 ++++++
 crates/burn-backend-tests/tests/fusion/mod.rs |   1 +
 .../src/engine/trace/block.rs                 | 106 +++++++++++++++---
 3 files changed, 121 insertions(+), 18 deletions(-)
 create mode 100644 crates/burn-backend-tests/tests/fusion/flex32_locals.rs

diff --git a/crates/burn-backend-tests/tests/fusion/flex32_locals.rs b/crates/burn-backend-tests/tests/fusion/flex32_locals.rs
new file mode 100644
index 00000000..3ee38f28
--- /dev/null
+++ b/crates/burn-backend-tests/tests/fusion/flex32_locals.rs
@@ -0,0 +1,32 @@
+//! Regression test for F32 and Flex32 locals overwriting each other in a fused kernel.
+//!
+//! The generated kernel keeps F32 and Flex32 block locals in the same `l_f32` registry, but the
+//! local pool numbered each precision on its own. `hard_sigmoid` computes in F32, so on a Flex32
+//! tensor its F32 local took the position of the Flex32 local holding `y`, and the final
+//! multiplication read the wrong value.
+
+use super::*;
+use burn_tensor::{DType, Device, TensorData, Tolerance, activation::hard_sigmoid};
+
+#[test]
+fn fusion_flex32_mul_by_hard_sigmoid_matches_reference() {
+    let device = Device::default();
+    if !device.supports_dtype(DType::Flex32) {
+        return;
+    }
+
+    let y = TestTensor::<2>::from_data([[1.0, 2.0, 3.0, 4.0]], (&device, DType::F32))
+        .cast(DType::Flex32);
+    let gate = TestTensor::<2>::from_data([[-3.0, 0.0, 1.5, 3.0]], (&device, DType::F32))
+        .cast(DType::Flex32);
+    device.sync().unwrap();
+
+    let output = y.mul(hard_sigmoid(gate, 0.2, 0.5));
+
+    // y * clamp(0.2 * gate + 0.5, 0, 1)
+    let expected = TensorData::from([[0.0f32, 1.0, 2.4, 4.0]]);
+    output
+        .cast(DType::F32)
+        .into_data()
+        .assert_approx_eq::<f32>(&expected, Tolerance::rel_abs(5e-3, 1e-2));
+}
diff --git a/crates/burn-backend-tests/tests/fusion/mod.rs b/crates/burn-backend-tests/tests/fusion/mod.rs
index 81f863a8..d824ec0d 100644
--- a/crates/burn-backend-tests/tests/fusion/mod.rs
+++ b/crates/burn-backend-tests/tests/fusion/mod.rs
@@ -1,6 +1,7 @@
 pub use super::*;
 
 mod cat;
+mod flex32_locals;
 mod fusion_f16_broadcast;
 mod fusion_f16_write_vectorization;
 mod fusion_shape;
diff --git a/crates/burn-cubecl-fusion/src/engine/trace/block.rs b/crates/burn-cubecl-fusion/src/engine/trace/block.rs
index a4d3db2b..f8d993ee 100644
--- a/crates/burn-cubecl-fusion/src/engine/trace/block.rs
+++ b/crates/burn-cubecl-fusion/src/engine/trace/block.rs
@@ -484,13 +484,31 @@ impl FuseBlockBuilder {
 
 #[derive(Default, Clone, Debug)]
 pub struct LocalVariablePool {
-    values: BTreeMap<FuseType, BTreeMap<TensorId, usize>>,
+    /// Keyed by the *storage* precision, not the declared one: the generated
+    /// kernel keeps `F32` and `Flex32` locals in the same `l_f32` registry
+    /// (see `codegen/io.rs`), so their positions must come from one sequence.
+    /// With one sequence per declared precision, a `Flex32` local and an
+    /// `F32` local could share a position and overwrite each other — which is
+    /// exactly what happened whenever a fused kernel cast `Flex32` to `F32` in
+    /// the middle of a chain (`hard_sigmoid` on a Flex32 tensor computes in
+    /// `F32`): the PP-OCR detector rendered an empty map in Flex32 while every
+    /// operation taken alone was exact.
+    values: BTreeMap<FuseType, BTreeMap<TensorId, (usize, FuseType)>>,
 }
 
 impl LocalVariablePool {
+    /// The registry a precision is stored in by the generated kernel.
+    fn storage(precision: FuseType) -> FuseType {
+        match precision {
+            FuseType::Flex32 => FuseType::F32,
+            other => other,
+        }
+    }
+
     fn get(&self, precision: FuseType, tensor_id: TensorId) -> Option<FuseArg> {
-        if let Some(indexes) = self.values.get(&precision)
-            && let Some(index) = indexes.get(&tensor_id)
+        if let Some(indexes) = self.values.get(&Self::storage(precision))
+            && let Some((index, declared)) = indexes.get(&tensor_id)
+            && *declared == precision
         {
             return Some(FuseArg::BlockLocal {
                 pos: *index,
@@ -502,11 +520,11 @@ impl LocalVariablePool {
     }
 
     fn get_any_precision(&self, tensor_id: TensorId) -> Option<FuseArg> {
-        for (precision, indexes) in self.values.iter() {
-            if let Some(index) = indexes.get(&tensor_id) {
+        for indexes in self.values.values() {
+            if let Some((index, declared)) = indexes.get(&tensor_id) {
                 return Some(FuseArg::BlockLocal {
                     pos: *index,
-                    ty: *precision,
+                    ty: *declared,
                 });
             }
         }
@@ -515,18 +533,9 @@ impl LocalVariablePool {
     }
 
     fn create(&mut self, precision: FuseType, tensor_id: TensorId) -> FuseArg {
-        if let Some(indexes) = self.values.get_mut(&precision) {
-            let new_index = indexes.len();
-            indexes.insert(tensor_id, new_index);
-            return FuseArg::BlockLocal {
-                pos: new_index,
-                ty: precision,
-            };
-        }
-
-        let new_index = 0;
-        self.values
-            .insert(precision, BTreeMap::from_iter([(tensor_id, new_index)]));
+        let indexes = self.values.entry(Self::storage(precision)).or_default();
+        let new_index = indexes.len();
+        indexes.insert(tensor_id, (new_index, precision));
 
         FuseArg::BlockLocal {
             pos: new_index,
@@ -534,3 +543,64 @@ impl LocalVariablePool {
         }
     }
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn position(arg: FuseArg) -> (usize, FuseType) {
+        match arg {
+            FuseArg::BlockLocal { pos, ty } => (pos, ty),
+            other => panic!("expected a block local, got {other:?}"),
+        }
+    }
+
+    /// `F32` and `Flex32` locals are read from and written to the same `l_f32`
+    /// registry by the generated kernel, so two live locals must never be handed
+    /// the same position, whatever their declared precision.
+    #[test]
+    fn f32_and_flex32_locals_never_share_a_position() {
+        let mut pool = LocalVariablePool::default();
+
+        let input = pool.create(FuseType::Flex32, TensorId::new(0));
+        let gate = pool.create(FuseType::Flex32, TensorId::new(1));
+        // A `Flex32` value promoted to `F32` mid-chain, e.g. by `hard_sigmoid`.
+        let promoted = pool.create(FuseType::F32, TensorId::new(2));
+        let sum = pool.create(FuseType::F32, TensorId::new(3));
+
+        let positions = [input, gate, promoted, sum].map(position);
+        for (i, (pos_a, _)) in positions.iter().enumerate() {
+            for (pos_b, _) in positions.iter().skip(i + 1) {
+                assert_ne!(pos_a, pos_b, "two l_f32 locals share position {pos_a}");
+            }
+        }
+
+        // The declared precision is kept, and each tensor is found again under it.
+        assert_eq!(positions[0].1, FuseType::Flex32);
+        assert_eq!(positions[2].1, FuseType::F32);
+        assert_eq!(
+            pool.get(FuseType::Flex32, TensorId::new(1)).map(position),
+            Some(positions[1])
+        );
+        assert_eq!(
+            pool.get(FuseType::F32, TensorId::new(3)).map(position),
+            Some(positions[3])
+        );
+        assert_eq!(
+            pool.get_any_precision(TensorId::new(2)).map(position),
+            Some(positions[2])
+        );
+    }
+
+    /// Other storage classes keep their own numbering.
+    #[test]
+    fn locals_of_different_registries_are_numbered_independently() {
+        let mut pool = LocalVariablePool::default();
+
+        let float = position(pool.create(FuseType::F32, TensorId::new(0)));
+        let int = position(pool.create(FuseType::I32, TensorId::new(1)));
+        let half = position(pool.create(FuseType::F16, TensorId::new(2)));
+
+        assert_eq!((float.0, int.0, half.0), (0, 0, 0));
+    }
+}
-- 
2.55.0

