{
  "nom": "daemon",
  "couleurs": {
    "fond": "#050505",
    "texte": "#ff3333",
    "halo": ["#ff0000", "#8b0000"],
    "sourdine": "#666666"
  },
  "police": "'Courier New', Courier, monospace",
  "animations": {
    "reflechit": {
      "forme": "cercle",
      "ms": 150,
      "glyphes": ["᚛", "ᚨ", "ᛒ", "ᛟ", "᚜", "⸸", "‡"],
      "coeur": "⛧",
      "gabarits": ["⟪ {gauche} {coeur} {droite} ⟫ INVOCATION DU CODE..."]
    },
    "lit": {
      "forme": "transmutation",
      "ms": 200,
      "glyphes": ["⍟", "🜂", "☿", "☉", "♄", "🜄", "∮"],
      "coeur": "⸸",
      "gabarits": ["⁅ {coeur} ⁆—[ {s} ]—⁅ {coeur} ⁆ ANALYSE EN COURS..."]
    },
    "ecrit": {
      "forme": "glitch",
      "ms": 100,
      "glyphes": ["∇", "∫", "∃", "∀", "∴", "∵", "⊕", "⊗", "⌇"],
      "coeur": "⛧",
      "gabarits": [
        "[{a} {coeur} {b}] ...COMPILING CURSE...",
        "❬{a}{b} {coeur} {c}❭ ...SUMMONING COMPILER...",
        " {a} ⸢{coeur}⸣ {b}  ...PARSING SOULS..."
      ]
    }
  },
  "replis": { "🜂": "△", "🜄": "▽" },
  "ascii": {
    "coeur": "*",
    "glyphes": ["|", "/", "-", "\\"],
    "cadre": { "⟪": "<<", "⟫": ">>", "⁅": "[", "⁆": "]", "—": "-", "⸢": "[", "⸣": "]", "❬": "<", "❭": ">", "⸸": "+" }
  }
}
