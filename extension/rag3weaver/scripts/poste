#!/bin/sh
# Verrou du poste, partagé entre les sessions.
#   poste mesure <commande…>   une mesure de durée ou de mémoire : seule sur le poste
#   poste cpu [--] <commande…> compilation, batterie, e2e, boucle : une place de cœurs, à plusieurs,
#                              mais jamais pendant une mesure, et en priorité basse
#   poste gpu <Gio> [--cpu] [--card cardN] [--disposable] -- <commande…>
#                              un modèle, un embarqueur, un e2e qui embarque : admis sur la mémoire restante de la
#                              carte (voir « La mémoire des cartes », plus bas) ; --cpu prend aussi une place de cœurs
#   poste lourd  <commande…>   l'ancien nom de cpu, accepté le temps que les sessions déclarent leur ressource
# La porte donne la priorité à la mesure : dès qu'une mesure attend, plus aucun
# travail lourd n'entre ; elle n'attend que la fin de ceux déjà lancés.
# Le travail lourd tourne en priorité basse (nice, ionice) : l'écran et la
# personne devant le poste passent avant lui.
#
# Plafond de mémoire (5 octobre 2026, après la panne du 4 à 22 h 51 : le
# gardien de mémoire du système a tué VSCodium entier, sessions comprises,
# parce que tout ce que les sessions lançaient vivait dans sa portée).
# Chaque commande tourne désormais dans SA portée systemd, avec un plafond :
# un travail qui déborde est tué seul (code 137), les sessions restent.
#   POSTE_MEM_MAX   plafond de mémoire de la commande   (défaut 40G)
#   POSTE_SWAP_MAX  plafond d'échange de la commande    (défaut 4G)
# Un travail qui a vraiment besoin de plus le demande : POSTE_MEM_MAX=64G poste …
#
# Le descripteur du verrou n'est PAS transmis à la commande (11 octobre 2026) :
# sans cela, tout processus lancé par la commande héritait du verrou, et un
# `tail -f` orphelin a tenu le poste en partagé pendant 2 h 35, bloquant toute
# mesure. Le script tient la place lui-même et la rend à sa fin, orphelins ou
# pas (voir « La priorité au travail exclusif », plus bas).
#   poste --qui    qui tient la place, qui attend (mesure ou lourd), depuis quand
#
# Le nombre de lourds (7 novembre 2026, luciepc surchargé : sept passes tenaient
# la place partagée à la fois, la lib entière de codeparsers a pris 235 s au
# lieu de 40, et des témoins ont rougi sur « pas indexé en 60 s ») : au plus N
# lourds tiennent la place en même temps ; les suivants attendent dans l'ordre
# d'arrivée. N se lit à chaque tour dans le fichier `lourds-max` du dossier des
# verrous (une ligne, un nombre ; 2 s'il manque), POSTE_LOURDS_MAX l'emporte.
# L'enveloppe CPU (14 novembre 2026, luciepc à 33 de charge sur 24 cœurs avec quatre lourds, deux rouges
# d'environnement en découlant) : chaque commande tourne avec un quota CPU à côté de son plafond de mémoire.
# Les cœurs utiles sont les cœurs du poste moins `coeurs-libres` (fichier du dossier des verrous, à côté de
# `lourds-max` ; 2 s'il manque ; POSTE_COEURS_LIBRES l'emporte). Un lourd reçoit utiles / lourds-max cœurs, une
# mesure les reçoit tous : CPUQuota = cœurs × 100 %. Le même nombre est dit aux outils, dans l'enveloppe :
# POSTE_FILS, et RAYON_NUM_THREADS, CARGO_BUILD_JOBS, RUST_TEST_THREADS ramenés à lui s'ils sont absents ou
# plus grands. Le quota est la borne ; les nombres de fils évitent qu'un outil se batte contre elle.
#   POSTE_CPU_QUOTA   un autre quota pour cette commande (ex. 300%), en le sachant
D="$HOME/.cache/rag3weaver-build"
# POSTE_LOCK_DIR : un autre dossier pour les verrous du poste (porte, poste) — pour
# les témoins, qui ne doivent jamais prendre les verrous réels.
V="${POSTE_LOCK_DIR:-$D}"

# ── Le verrou de push sur master (11 octobre 2026) ─────────────────────────
#   poste push <session> -- <commande…>   attend son tour, puis exécute la
#                                         commande de la session (fetch, rebase,
#                                         rejeu court, push) verrou tenu
#   poste push --qui                      qui tient le verrou, depuis quand
# Trois sessions ont perdu trois courses chacune le 11 octobre : du code arrivait
# sur master pendant leur rejeu. Un seul tenant à la fois ; les autres attendent,
# en le disant toutes les 30 s. Le verrou tombe à la fin de la commande, succès
# ou échec. Au-delà de POSTE_PUSH_MAX secondes (défaut 1200), le tenant est dit
# sur la sortie d'erreur et dans la fiche, jamais tué. La commande est celle de
# la session : ce script ne fetch, ne rebase et ne pousse rien lui-même. Pas de
# plafond de mémoire ici : le rejeu dans la commande passe par `poste lourd`.
# POSTE_PUSH_DIR : un autre dossier pour le verrou de push — pour les essais,
# qui ne doivent JAMAIS attendre sur le verrou réel (le 11 octobre, un essai
# s'est mis dans la file réelle derrière une session qui poussait).
PUSH_DIR="${POSTE_PUSH_DIR:-$D}"
PUSH_LOCK="$PUSH_DIR/master-push.lock"
PUSH_FICHE="$PUSH_DIR/master-push.tenant"
# Le relais (11 octobre 2026) : un seul verrou de push pour tous les postes.
# Un poste qui a le fichier `poste-push-hote` (une ligne, `utilisateur@hôte`)
# prend le verrou de CET hôte par ssh, et ne tient jamais le sien : la session
# ssh demande le verrou là-bas et le garde tant que son entrée reste ouverte ;
# la commande tourne ici ; l'entrée se ferme à sa fin, et le verrou tombe.
# ssh muet : refus nommé, rien n'est exécuté. ssh perdu pendant la commande :
# dit haut et fort (la commande n'est pas tuée, elle peut être à mi-push).
# POSTE_PUSH_HOTE posé, même vide, l'emporte sur le fichier : vide = pas de
# relais (les témoins, qui ne doivent jamais relayer vers un autre poste).
PUSH_HOTE="${POSTE_PUSH_HOTE-$(cat "$D/poste-push-hote" 2>/dev/null)}"
SSH_PUSH="ssh -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=4"

# ── L'état de la CI, dit avant chaque push (18 octobre 2026, le filet du ticket « la CI de
# rag3weaver était rouge sans que personne le voie ») ──
# La conclusion du dernier run de master de chaque workflow, et « CI rouge depuis <date> »
# s'il le faut. Ne bloque jamais : 20 s au plus, et un état illisible se dit en une ligne.
# POSTE_CI_DEPOT (L-Defraiteur/rag3db) ; POSTE_CI=0 le tait (les témoins).
etat_de_la_ci() {
  [ "${POSTE_CI:-1}" = 0 ] && return 0
  local depot="${POSTE_CI_DEPOT:-L-Defraiteur/rag3db}" jeton
  jeton=$(gh auth token --user L-Defraiteur 2>/dev/null || true)
  GH_TOKEN="${jeton:-${GH_TOKEN:-}}" timeout 20 python3 - "$depot" <<'ETAT' >&2 || echo "poste push : état de la CI illisible (gh ou réseau)" >&2
import json, subprocess, sys
sys.excepthook = lambda *_: sys.exit(1)  # illisible : la ligne de bash le dit, sans trace
depot = sys.argv[1]
def api(chemin):
    return json.loads(subprocess.run(["gh", "api", chemin], capture_output=True, text=True, check=True).stdout)
runs = api(f"repos/{depot}/actions/runs?branch=master&per_page=100")["workflow_runs"]
derniers = {}
for r in runs:  # du plus récent au plus ancien
    if r["status"] != "completed" or r["conclusion"] in ("cancelled", "skipped"):
        continue
    derniers.setdefault(r["workflow_id"], r)
lignes = []
for wid, r in sorted(derniers.items(), key=lambda kv: kv[1]["name"]):
    if r["conclusion"] == "success":
        lignes.append(f"  vert   {r['name']} ({r['created_at'][:10]})")
        continue
    vert = api(f"repos/{depot}/actions/workflows/{wid}/runs?branch=master&status=success&per_page=1")["workflow_runs"]
    filtre = f"&created=>{vert[0]['created_at']}" if vert else ""
    apres = api(f"repos/{depot}/actions/workflows/{wid}/runs?branch=master&per_page=100{filtre}")["workflow_runs"]
    rouges = [x for x in apres if x["conclusion"] == "failure"]
    depuis = rouges[-1]["created_at"][:16].replace("T", " ") if rouges else r["created_at"][:16].replace("T", " ")
    plus = "" if len(apres) < 100 else " au moins"
    lignes.append(f"  ROUGE  {r['name']} : CI rouge depuis{plus} {depuis} UTC" + ("" if vert else " (aucun vert connu)"))
print("poste push : la CI de master, dernier run de chaque workflow (sans bloquer)")
print("\n".join(lignes) if lignes else "  aucun run terminé")
ETAT
}
# ── L'ordre des verrous : le poste d'abord, le push ensuite (11 octobre 2026, soir) ──
# Une commande de push qui rejouait sous `poste lourd` tenait le verrou de push en
# attendant le poste : 28 min derrière une mesure (arbre principal), et tout le
# monde attendait derrière elle pour rien.
#   poste push <session> --lourd -- <commande…>   (ou POSTE_PUSH_LOURD=1)
# prend d'abord la place `lourd` du poste, au plus POSTE_PUSH_LOURD_MAX secondes
# (60) ; sinon « poste occupé par … », code 75, RIEN de pris : la session se remet
# en file plus tard. Puis le verrou de push, puis la commande, dans le plafond de
# mémoire et la priorité basse du lourd. La commande n'appelle plus `poste lourd` :
# dedans (POSTE_DANS_LOURD), `poste lourd` passe la main tel quel. Jamais
# l'inverse. Une mesure ne connaît pas le push : `poste mesure` attend les
# partagés en cours, comme avant.
if [ "${1:-}" = "push" ] && [ "${2:-}" != "--qui" ] && [ -z "${POSTE_DANS_LOURD:-}" ] \
   && { [ "${3:-}" = "--lourd" ] || [ -n "${POSTE_PUSH_LOURD:-}" ]; }; then
  nom="${2:-}"; shift; [ $# -gt 0 ] && shift
  [ "${1:-}" = "--lourd" ] && shift
  [ "${1:-}" = "--" ] && shift
  if [ -z "$nom" ] || [ $# -eq 0 ]; then
    echo "usage: poste push <session> [--lourd] -- <commande…>   |   poste push --qui" >&2; exit 2
  fi
  attente="${POSTE_PUSH_LOURD_MAX:-60}"
  commande_tapee="$*"
  # (7 novembre 2026) La place se prend par `poste lourd` lui-même, avec son délai
  # d'attente : un push lourd compte parmi les N lourds et attend dans la même file.
  occupe() {
    # Le tenant d'un verrou est un `flock` : on nomme la commande au bout de sa chaîne.
    tenants=""
    for pid in $(lslocks -n -o PID,PATH 2>/dev/null | awk -v a="$V/porte.lock" -v b="$V/poste.lock" '$2==a || $2==b {print $1}' | sort -u); do
      bout=$pid
      for _ in 1 2 3 4 5; do
        fils=$(ps -o pid= --ppid "$bout" 2>/dev/null | head -1 | tr -d ' ')
        # On descend à travers flock et à travers ce script (qui tient lui-même
        # ses verrous depuis le 11 octobre au soir) jusqu'à la commande.
        case "$(ps -o comm= -p "$bout") $(ps -o args= -p "$bout")" in
          "flock "*|*"/poste "*) [ -n "$fils" ] && bout=$fils || break ;;
          *) break ;;
        esac
      done
      case "$tenants" in *"(pid $bout)"*) continue ;; esac
      tenants="$tenants$(ps -o args= -p "$bout" 2>/dev/null | cut -c1-80) (pid $bout) ; "
    done
    echo "poste push : $nom — poste occupé${tenants:+ par $tenants}depuis $attente s : rien de pris (ni le poste ni le push), code 75 ; se remettre en file plus tard" >&2
    # Un rejeu qui tourne sur l'autre poste prend sa place sous le poste lourd
    # de CE poste-là : `--lourd` local ne sert que si la commande bâtit ou
    # mesure ici (12 octobre 2026 : le cœur refusé vingt fois en cinquante
    # minutes derrière un index local, pour un rejeu sur luciepc).
    case "$commande_tapee" in
      *ssh*) echo "poste push : $nom — la commande parle à un autre poste par ssh : si rien ne bâtit ni ne mesure ici, lance-la sans --lourd (et prends le poste lourd de l'autre poste dans la commande)" >&2 ;;
    esac
    exit 75
  }
  POSTE_LOURD_ATTENTE_MAX="$attente" "$0" lourd env POSTE_DANS_LOURD=1 "$0" push "$nom" -- "$@"
  rc=$?
  [ "$rc" -eq 75 ] && occupe
  exit "$rc"
fi
# Dedans un push lourd : la place est déjà prise, `poste lourd` passe la main ;
# une mesure n'a rien à faire là (elle attendrait le partagé qui la contient).
if [ -n "${POSTE_DANS_LOURD:-}" ]; then
  case "${1:-}" in
    lourd|cpu) shift; [ "${1:-}" = -- ] && shift; exec "$@" ;;
    mesure) echo "poste: une mesure ne se lance pas depuis un push lourd (elle attendrait sa propre place)" >&2; exit 2 ;;
  esac
fi

if [ "${1:-}" = "push" ] && [ -n "$PUSH_HOTE" ]; then
  shift
  if [ "${1:-}" = "--qui" ]; then
    env_distant=""; [ -n "${POSTE_PUSH_DIR:-}" ] && env_distant="POSTE_PUSH_DIR='$POSTE_PUSH_DIR' "
    # -n : ne pas avaler l'entrée du script qui appelle (vu le 11 octobre).
    $SSH_PUSH -n "$PUSH_HOTE" "${env_distant}~/.cache/rag3weaver-build/poste push --qui" && exit 0
    echo "poste push : le verrou de $PUSH_HOTE ne répond pas (ssh)" >&2; exit 3
  fi
  nom="${1:-}"; [ $# -gt 0 ] && shift
  [ "${1:-}" = "--" ] && shift
  if [ -z "$nom" ] || [ $# -eq 0 ]; then
    echo "usage: poste push <session> [--lourd] -- <commande…>   |   poste push --qui" >&2; exit 2
  fi
  canal=$(mktemp -d "$D/push-relais-XXXXXX") || exit 3
  mkfifo "$canal/entree" "$canal/sortie" || { rm -rf "$canal"; exit 3; }
  ici=$(hostname)
  env_distant=""; [ -n "${POSTE_PUSH_DIR:-}" ] && env_distant="POSTE_PUSH_DIR='$POSTE_PUSH_DIR' "
  $SSH_PUSH "$PUSH_HOTE" "${env_distant}~/.cache/rag3weaver-build/poste push '$nom@$ici' -- sh -c 'echo PRIS; cat >/dev/null'" \
    < "$canal/entree" > "$canal/sortie" &
  relais=$!
  exec 8>"$canal/entree"
  ligne=""
  read -r ligne < "$canal/sortie"
  if [ "$ligne" != "PRIS" ]; then
    exec 8>&-; wait "$relais" 2>/dev/null; rm -rf "$canal"
    echo "poste push : le verrou de $PUSH_HOTE n'a pas pu être pris (ssh muet ou refusé) — rien n'est exécuté, jamais de push sans verrou" >&2
    exit 3
  fi
  echo "poste push : $nom@$ici tient le verrou de $PUSH_HOTE" >&2
  etat_de_la_ci 8>&-
  "$@" 0<&0 &
  enfant=$!
  perdu=0
  while kill -0 "$enfant" 2>/dev/null; do
    if [ "$perdu" = 0 ] && ! kill -0 "$relais" 2>/dev/null; then
      echo "poste push : VERROU PERDU — la session ssh vers $PUSH_HOTE est tombée pendant la commande de $nom ; vérifiez master avant de croire ce push" >&2
      perdu=1
    fi
    sleep 2
  done
  wait "$enfant"; rc=$?
  exec 8>&-
  wait "$relais" 2>/dev/null
  rm -rf "$canal"
  [ "$perdu" = 1 ] && [ "$rc" -eq 0 ] && rc=70
  exit "$rc"
fi

case "$1" in
  push)
    shift
    if [ "${1:-}" = "--qui" ]; then
      if flock -n -x "$PUSH_LOCK" true 2>/dev/null; then
        echo "poste push : libre"
        # Une fiche sans verrou : un tenant tué sans finir (SIGKILL).
        [ -s "$PUSH_FICHE" ] && { echo "poste push : fiche périmée retirée — $(cat "$PUSH_FICHE")"; rm -f "$PUSH_FICHE"; }
      else
        # Le tenant vrai : le processus qui tient le verrou (le noyau le dit),
        # et la commande au bout de sa chaîne ; la fiche donne le nom.
        verrou=$(lslocks -n -o PID,PATH 2>/dev/null | awk -v p="$PUSH_LOCK" '$2==p {print $1; exit}')
        commande=""
        if [ -n "$verrou" ]; then
          commande=$(ps -o args= --ppid "$verrou" 2>/dev/null | grep -v '^sleep' | head -1 | cut -c1-90)
        fi
        if [ -s "$PUSH_FICHE" ]; then
          echo "poste push : tenu — $(cat "$PUSH_FICHE")"
        else
          echo "poste push : tenu — sans fiche${verrou:+ ; verrou au pid $verrou}${commande:+ — $commande}"
        fi
      fi
      exit 0
    fi
    nom="${1:-}"; [ $# -gt 0 ] && shift
    [ "${1:-}" = "--" ] && shift
    if [ -z "$nom" ] || [ $# -eq 0 ]; then
      echo "usage: poste push <session> [--lourd] -- <commande…>   |   poste push --qui" >&2; exit 2
    fi
    debut=$(date +%s)
    # **Le verrou est tenu par ce script** (descripteur 7), pas par un `flock`
    # qui l'envelopperait (12 octobre 2026, relevé du cœur) : un `flock` tué
    # rendait le verrou pendant que la commande, orpheline, poussait encore —
    # deux pushes en même temps, et `--qui` ne nommait que le second. Ce
    # script attend, prend, puis protège le verrou de ses signaux tant que la
    # commande vit ; la commande n'en hérite pas (`7>&-`). Seul SIGKILL passe
    # outre, et `--qui` dit alors une fiche périmée.
    exec 7>>"$PUSH_LOCK"
    while ! flock -x -w 30 7; do
      echo "poste push : $nom attend depuis $(( $(date +%s) - debut )) s — tenu par $(cat "$PUSH_FICHE" 2>/dev/null || echo 'tenant inconnu')" >&2
    done
    plafond="${POSTE_PUSH_MAX:-1200}"
    echo "$nom depuis $(date '+%H:%M:%S') (pid $$)" > "$PUSH_FICHE"
    # Le verrou est protégé **dès qu'il est pris** (14 novembre 2026, cas 6c du témoin) : la lecture de la CI
    # qui suit dure jusqu'à 20 s, et un TERM reçu pendant elle tuait le script avant le `trap` d'en dessous —
    # la place rendue, la commande jamais lancée, sans un mot. Le signal est dit, et la commande court.
    trap 'echo "poste push : $nom — signal reçu avant la commande ; le verrou reste tenu, la commande va courir" >&2' TERM INT HUP
    etat_de_la_ci 7>&-
    # L'entrée est gardée explicitement : sans job control, un `&` la remplace
    # par /dev/null, et le relais d'un autre poste (qui tient le verrou tant
    # que son entrée reste ouverte) le rendrait aussitôt.
    "$@" 0<&0 7>&- &
    enfant=$!
    trap 'echo "poste push : $nom — signal reçu ; le verrou reste tenu jusqu à la fin de la commande (pid $enfant), qu on arrête elle-même" >&2' TERM INT HUP
    dit=0; t0=$(date +%s)
    while kill -0 "$enfant" 2>/dev/null; do
      if [ "$dit" = 0 ] && [ $(( $(date +%s) - t0 )) -ge "$plafond" ]; then
        echo "poste push : $nom tient le verrou depuis plus de $plafond s — dit, pas tué" >&2
        echo "$nom depuis $(date -d "@$t0" '+%H:%M:%S') (pid $$) — AU-DELÀ DE $plafond s" > "$PUSH_FICHE"
        dit=1
      fi
      sleep 1 7>&-
    done
    wait "$enfant"; rc=$?
    rm -f "$PUSH_FICHE"
    exit "$rc" ;;
esac
MEM="${POSTE_MEM_MAX:-40G}"
SWAP="${POSTE_SWAP_MAX:-4G}"
usage() {
  echo "usage: poste mesure|cpu <commande…>   |   poste gpu <Gio> [--cpu] [--card cardN] [--disposable] -- <commande…>   |   poste --qui   |   poste places <N> [jusqu'à HH:MM | AAAA-MM-JJ HH:MM]   |   poste push <session> [--lourd] -- <commande…>   |   poste push --qui" >&2
  exit 2
}
mode="${1:-}"; [ $# -gt 0 ] && shift
F="$V/fiches"
# ── Les classes déclarées (21 novembre 2026, Lucie par c7 : « il ne faut pas qu'on dise juste lourd sans justifier si on
# prend principalement CPU ou GPU ») ──
# `poste cpu` prend une place de cœurs (l'enveloppe d'un lourd). `poste gpu <Gio>` est admis sur la mémoire restante, pas
# sur un nombre : sans --cpu il ne prend pas de place de cœurs, avec --cpu il en prend une aussi. `poste lourd` reste un
# alias de cpu, et le dit. La fiche dit la classe : « tient cpu », « tient gpu 12G », « tient gpu+cpu 12G », et la carte
# quand le travail en nomme une (« tient gpu 8G card0 »).
classe=$mode; GPU_NEED=""; GPU_CPU=0; GPU_CARD_ASKED=""; GPU_DISPOSABLE=0
case "$mode" in
  lourd) echo "poste lourd : déclarer la ressource — « poste cpu -- … » (cœurs) ou « poste gpu <Gio> [--cpu] -- … » (mémoire de carte) ; lourd vaut cpu pour l'instant" >&2
         mode=cpu; classe=cpu ;;
  cpu) [ "${1:-}" = -- ] && shift ;;
  gpu)
    GPU_NEED=${1:-}
    case "$GPU_NEED" in ''|*[!0-9]*|0) echo "poste gpu : un besoin en Gio (un entier ≥ 1), puis -- et la commande" >&2; exit 2 ;; esac
    shift
    while [ $# -gt 0 ]; do
      case "$1" in
        --cpu) GPU_CPU=1; shift ;;
        --disposable) GPU_DISPOSABLE=1; shift ;;
        --card) GPU_CARD_ASKED=${2:-}; [ $# -ge 2 ] && shift; shift ;;
        --) shift; break ;;
        *) break ;;
      esac
    done
    classe="gpu ${GPU_NEED}G"; [ "$GPU_CPU" = 1 ] && classe="gpu+cpu ${GPU_NEED}G"
    [ -n "$GPU_CARD_ASKED" ] && classe="$classe $GPU_CARD_ASKED" ;;
esac
# La file des lourds : un billet `<instant en ns>-<pid>` par lourd qui attend ; l'ordre
# des noms est l'ordre d'arrivée. Un billet dont le processus est mort est retiré.
# **La voie du pousseur** (19 novembre 2026, c7 et G : sa passe attendait derrière sept lourds, et tout le monde attend
# ses passes pour atterrir) : sous POSTE_VOIE=pousseur, le billet s'appelle `0-<instant>-<pid>` et passe devant les
# autres ; la porte ne change pas, une mesure en attente reste devant lui. Le pid se lit après le dernier tiret.
T="$V/file"
# **Une baisse des places porte son heure de retour** (20 novembre 2026, c7 : la tablette est restée à une place de
# 07 h 30 à 13 h 35, la fenêtre du matin finie à 08 h 51). `lourds-max.retour` dit « <valeur d'avant> <instant> » ; à la
# première lecture passé l'instant, la valeur d'avant revient et le retour s'efface.
retour_des_places() {
  [ -s "$V/lourds-max.retour" ] || return 0
  read -r _avant _quand < "$V/lourds-max.retour" 2>/dev/null || return 0
  case "$_avant$_quand" in ''|*[!0-9]*) return 0 ;; esac
  [ "$(date +%s)" -ge "$_quand" ] || return 0
  echo "$_avant" > "$V/lourds-max"; rm -f "$V/lourds-max.retour"
}
places() {
  retour_des_places
  _n="${POSTE_LOURDS_MAX:-$(cat "$V/lourds-max" 2>/dev/null)}"
  case "$_n" in ''|*[!0-9]*) _n=2 ;; esac
  [ "$_n" -ge 1 ] || _n=1
  echo "$_n"
}
coeurs_libres() {
  _l="${POSTE_COEURS_LIBRES:-$(cat "$V/coeurs-libres" 2>/dev/null)}"
  case "$_l" in ''|*[!0-9]*) _l=2 ;; esac
  echo "$_l"
}
# fils_par <mode> : les cœurs d'une commande de ce mode, au moins 1.
fils_par() {
  # `nproc --all` : les cœurs du poste. Sous un quota (cpu.max), `nproc` rend le quota (14 novembre 2026 : 5 dans un
  # lourd de 500 % à luciepc), et un poste lancé sous un quota étranger calculait ses parts sur lui.
  _u=$(( $(nproc --all 2>/dev/null || echo 1) - $(coeurs_libres) ))
  [ "$_u" -ge 1 ] || _u=1
  if [ "$1" = lourd ]; then _u=$(( _u / $(places) )); fi
  [ "$_u" -ge 1 ] || _u=1
  echo "$_u"
}
# borner_fils <n> : une variable de fils absente ou plus grande que n est ramenée à n.
borner_fils() {
  POSTE_FILS=$1; export POSTE_FILS
  for _v in RAYON_NUM_THREADS CARGO_BUILD_JOBS RUST_TEST_THREADS; do
    eval "_x=\${$_v:-}"
    case "$_x" in ''|*[!0-9]*) eval "$_v=$1" ;; *) [ "$_x" -gt "$1" ] && eval "$_v=$1" ;; esac
    export "$_v"
  done
}
lourds_tenus() {
  _k=0
  for _f in "$F"/*; do
    [ -f "$_f" ] || continue
    case "$(cat "$_f" 2>/dev/null)" in "tient lourd"*|"tient cpu"*|"tient gpu+cpu"*) kill -0 "${_f##*/}" 2>/dev/null && _k=$((_k + 1)) ;; esac
  done
  echo "$_k"
}
# file_des_lourds [billet] : les pids en attente dans l'ordre ; avec un billet, son rang (0 = premier).
file_des_lourds() {
  _r=0
  for _t in $(ls "$T" 2>/dev/null | sort); do
    kill -0 "${_t##*-}" 2>/dev/null || { rm -f "$T/$_t"; continue; }
    if [ -n "${1:-}" ]; then
      [ "$T/$_t" = "$1" ] && { echo "$_r"; return 0; }
    else
      echo "${_t##*-}"
    fi
    _r=$((_r + 1))
  done
  [ -n "${1:-}" ] && echo "$_r"
  return 0
}

# ── La mémoire des cartes (poste gpu, 21 novembre 2026) ─────────────────────
# `gpu-card` (dossier des verrous) nomme la carte du poste (card2 à luciepc) ; absent, la mémoire est unifiée (l'APU de
# la tablette) et se lit dans /proc/meminfo. `gpu-reserve-gib` : la réserve, en Gio ; sur une carte, la VRAM gardée aux
# services d'embarquement à leur pic (19 à luciepc : 18,7 Gio mesurés sur card2 le 21 novembre, référence de granite) ;
# en mémoire unifiée, ce qui reste libre au poste (30 par défaut, mot de Lucie).
# L'admission, dans l'ordre d'arrivée des gpu, sous le verrou des gpu :
# - sur une carte : le registre, réserve + Σ besoins déclarés des gpu tenus + besoin ≤ VRAM totale ; et la mesure,
#   VRAM totale − utilisée − Σ besoins des gpu admis depuis moins de POSTE_GPU_SETTLE s (300 ; pas encore alloués)
#   − besoin ≥ 1 Gio ;
# - en mémoire unifiée : MemAvailable − Σ besoins récents − besoin ≥ la réserve.
# Le calendrier : ouvert du vendredi 18:00 au lundi 08:00 ; en semaine, là où le fichier `gpu-weekdays` existe
# (luciepc). Sinon `poste gpu` refuse tout de suite, code 77.
# card0 (les écrans de luciepc) : jamais comme carte du poste. Un travail la demande par --card card0, la nuit seulement
# (01:00 à 08:00), sans session sur seat1, déclaré jetable (--disposable : un banc, une mesure, une sonde), sa durée
# bornée par un timeout en tête qui finit avant 08:00 ; sa réserve est sa VRAM utilisée à l'instant, plus 1 Gio.
TG="$V/file-gpu"
GPU_SYS="${POSTE_GPU_SYS:-/sys}"
GPU_MEMINFO="${POSTE_GPU_MEMINFO:-/proc/meminfo}"
gpu_now() { echo "${POSTE_GPU_NOW:-$(date +%s)}"; }
gpu_machine_card() { tr -d ' \n' < "$V/gpu-card" 2>/dev/null; }
gpu_card() { if [ -n "$GPU_CARD_ASKED" ]; then echo "$GPU_CARD_ASKED"; else gpu_machine_card; fi; }
gpu_mib_of() { _o=$(cat "$GPU_SYS/class/drm/$1/device/$2" 2>/dev/null); case "$_o" in ''|*[!0-9]*) echo "" ;; *) echo $((_o / 1048576)) ;; esac; }
gpu_meminfo_mib() { awk -v k="$1:" '$1 == k {print int($2 / 1024)}' "$GPU_MEMINFO" 2>/dev/null; }
gpu_reserve_mib() {
  _r=$(tr -d ' \n' < "$V/gpu-reserve-gib" 2>/dev/null)
  case "$_r" in ''|*[!0-9]*) if [ -n "$(gpu_machine_card)" ]; then _r=0; else _r=30; fi ;; esac
  echo $((_r * 1024))
}
# gpu_open : 0 si le calendrier admet un gpu maintenant ; sinon la raison sur la sortie.
gpu_open() {
  [ -e "$V/gpu-weekdays" ] && return 0
  _n=$(gpu_now); _j=$(date -d "@$_n" +%u); _h=$(date -d "@$_n" +%H%M)
  case "$_j" in 6|7) return 0 ;; esac
  [ "$_j" = 5 ] && [ "$_h" -ge 1800 ] && return 0
  [ "$_j" = 1 ] && [ "$_h" -lt 800 ] && return 0
  echo "poste gpu : fermé ici en semaine (ouvert du vendredi 18:00 au lundi 08:00 ; en semaine là où gpu-weekdays existe)"
  return 1
}
# gpu_declared_mib : Σ des besoins déclarés des gpu qui tiennent sur la même mémoire que ce travail (GPU_WHICH : « - »
# pour la carte du poste ou la mémoire unifiée, sinon la carte nommée) ; GPU_RECENT=1 : admis depuis moins de
# POSTE_GPU_SETTLE secondes.
gpu_declared_mib() {
  _s=0; _lim=$(( $(gpu_now) - ${POSTE_GPU_SETTLE:-300} ))
  for _f in "$F"/*; do
    [ -f "$_f" ] || continue
    _l=$(cat "$_f" 2>/dev/null); case "$_l" in "tient gpu"*) ;; *) continue ;; esac
    kill -0 "${_f##*/}" 2>/dev/null || continue
    set -f; set -- $_l; set +f
    _g=${3%G}; _c=-; [ "${4:-}" != depuis ] && _c=$4
    [ "$_c" = "$GPU_WHICH" ] || continue
    if [ "${GPU_RECENT:-}" = 1 ] && [ "$(stat -c %Y "$_f")" -lt "$_lim" ]; then continue; fi
    case "$_g" in ''|*[!0-9]*) ;; *) _s=$((_s + _g * 1024)) ;; esac
  done
  echo "$_s"
}
# gpu_refusal_now : un refus qui ne se résout pas en attendant (« <code> <raison> » : 2 ou 77), ou rien.
gpu_refusal_now() {
  _c=$(gpu_card)
  if [ "$(gpu_machine_card)" = card0 ]; then echo "2 poste gpu : gpu-card = card0, la carte des écrans : jamais comme carte du poste"; return 0; fi
  _ferme=$(gpu_open) || { echo "77 $_ferme"; return 0; }
  if [ "$_c" = card0 ]; then
    [ "$GPU_DISPOSABLE" = 1 ] || { echo "2 poste gpu --card card0 : seulement un travail jetable (--disposable : un banc, une mesure, une sonde) ; jamais un service, un index ou une base qui reste"; return 0; }
    _n=$(gpu_now); _h=$(date -d "@$_n" +%H%M)
    { [ "$_h" -ge 100 ] && [ "$_h" -lt 800 ]; } || { echo "77 poste gpu --card card0 : la nuit seulement, de 01:00 à 08:00"; return 0; }
    "${POSTE_GPU_LOGINCTL:-loginctl}" list-sessions --no-legend 2>/dev/null | grep -qw seat1 && { echo "77 poste gpu --card card0 : une session est ouverte sur seat1 (les écrans) : refusé"; return 0; }
    [ -n "$GPU_TIMEOUT_S" ] || { echo "2 poste gpu --card card0 : la durée doit être bornée par un timeout en tête de la commande, qui finit avant 08:00"; return 0; }
    _huit=$(date -d "$(date -d "@$_n" +%F) 08:00" +%s)
    [ $((_n + GPU_TIMEOUT_S)) -le "$_huit" ] || { echo "2 poste gpu --card card0 : le timeout ($GPU_TIMEOUT_S s) passe 08:00, quand les écrans reviennent"; return 0; }
  fi
  _b=$((GPU_NEED * 1024)); _r=$(gpu_reserve_mib)
  if [ -n "$_c" ]; then
    _t=$(gpu_mib_of "$_c" mem_info_vram_total)
    [ -n "$_t" ] || { echo "2 poste gpu : la carte $_c ne dit pas sa VRAM ($GPU_SYS/class/drm/$_c/device)"; return 0; }
    [ "$_c" = card0 ] && _r=0
    [ $((_r + _b)) -le "$_t" ] || { echo "2 poste gpu : besoin de $GPU_NEED Gio, plus que $_c ne tiendra jamais ($((_t / 1024)) Gio, réserve $((_r / 1024)))"; return 0; }
  else
    _t=$(gpu_meminfo_mib MemTotal)
    { [ -n "$_t" ] && [ $((_r + _b)) -le "$_t" ]; } || { echo "2 poste gpu : besoin de $GPU_NEED Gio, plus que la mémoire ne tiendra jamais (réserve $((_r / 1024)) Gio)"; return 0; }
  fi
  return 0
}
# gpu_admits : 0 si la mémoire admet le besoin maintenant.
gpu_admits() {
  _c=$(gpu_card); _b=$((GPU_NEED * 1024)); _r=$(gpu_reserve_mib)
  GPU_WHICH=-; [ -n "$GPU_CARD_ASKED" ] && GPU_WHICH=$GPU_CARD_ASKED
  _rec=$(GPU_RECENT=1 gpu_declared_mib); _tous=$(gpu_declared_mib)
  if [ -n "$_c" ]; then
    _t=$(gpu_mib_of "$_c" mem_info_vram_total); _u=$(gpu_mib_of "$_c" mem_info_vram_used)
    { [ -n "$_t" ] && [ -n "$_u" ]; } || return 1
    if [ "$_c" = card0 ]; then
      [ $((_t - _u - _rec - _b)) -ge 1024 ]
    else
      [ $((_r + _tous + _b)) -le "$_t" ] && [ $((_t - _u - _rec - _b)) -ge 1024 ]
    fi
  else
    _a=$(gpu_meminfo_mib MemAvailable); [ -n "$_a" ] || return 1
    [ $((_a - _rec - _b)) -ge "$_r" ]
  fi
}
# gpu_queue [billet] : comme file_des_lourds, pour la file des gpu.
gpu_queue() {
  _r=0
  for _t in $(ls "$TG" 2>/dev/null | sort); do
    kill -0 "${_t##*-}" 2>/dev/null || { rm -f -- "${TG:?}/${_t:?}"; continue; }
    if [ -n "${1:-}" ]; then [ "$TG/$_t" = "$1" ] && { echo "$_r"; return 0; }; else echo "${_t##*-}"; fi
    _r=$((_r + 1))
  done
  [ -n "${1:-}" ] && echo "$_r"
  return 0
}

# ── poste --qui : qui tient la place, qui attend, depuis quand ─────────────
# Chaque `poste mesure|lourd` tient une fiche (« attend » puis « tient ») tant
# qu'il vit ; une fiche dont le processus est mort est retirée ici.
if [ "$mode" = "--qui" ]; then
  vu=0
  for f in "$F"/*; do
    [ -e "$f" ] || continue
    if kill -0 "${f##*/}" 2>/dev/null; then cat "$f"; vu=1; else rm -f "$f"; fi
  done
  [ "$vu" = 0 ] && echo "poste : libre (aucune mesure, aucun lourd)"
  file=$(file_des_lourds | tr '\n' ' ')
  echo "lourds : $(lourds_tenus)/$(places) places tenues${file:+, en file dans l'ordre : pid $file}"
  _gt=0; _gd=0
  for _f in "$F"/*; do
    [ -f "$_f" ] || continue; _l=$(cat "$_f" 2>/dev/null)
    case "$_l" in "tient gpu"*) set -f; set -- $_l; set +f; _gt=$((_gt + 1)); _g=${3%G}; case "$_g" in *[!0-9]*|'') ;; *) _gd=$((_gd + _g)) ;; esac ;; esac
  done
  if gpu_open > /dev/null; then _o=ouvert; else _o="fermé (semaine)"; fi
  _c=$(gpu_machine_card)
  if [ -n "$_c" ]; then
    _m="VRAM $_c : $(( ($(gpu_mib_of "$_c" mem_info_vram_total) - $(gpu_mib_of "$_c" mem_info_vram_used)) / 1024 )) Gio libres, réserve des services $(( $(gpu_reserve_mib) / 1024 )) Gio"
  else
    _m="mémoire unifiée : $(( $(gpu_meminfo_mib MemAvailable) / 1024 )) Gio disponibles, réserve $(( $(gpu_reserve_mib) / 1024 )) Gio"
  fi
  _fg=$(gpu_queue | tr '\n' ' ')
  echo "gpu : $_o ; $_gt tenu(s), $_gd Gio déclarés ; $_m${_fg:+ ; en file : pid $_fg}"
  [ -s "$PUSH_FICHE" ] && echo "push : tenu — $(cat "$PUSH_FICHE")"
  if [ -s "$V/lourds-max.retour" ]; then
    read -r _avant _quand < "$V/lourds-max.retour"
    echo "places réglées à $(cat "$V/lourds-max" 2>/dev/null) jusqu'au $(date -d "@$_quand" '+%d/%m %H:%M') (puis $_avant)"
  fi
  exit 0
fi
# ── poste places <N> [jusqu'à HH:MM | AAAA-MM-JJ HH:MM] : changer le nombre de places lourdes ──
# Une baisse exige son heure de retour (c7, 20 novembre 2026) ; une hausse, ou un retour à la valeur d'avant, n'en a
# pas besoin et efface un retour en cours. Une heure déjà passée aujourd'hui est celle de demain.
if [ "$mode" = places ]; then
  _n=${1:-}; case "$_n" in ''|*[!0-9]*|0) echo "poste places : un nombre de places ≥ 1, puis jusqu'à HH:MM pour une baisse" >&2; exit 2 ;; esac
  # L'heure de retour : HH:MM, ou une date (« 2026-11-23 08:00 », « monday 08:00 ») ; le reste de la ligne.
  _h=""; [ $# -ge 3 ] && case "$2" in "jusqu'à"|jusqua|until) shift 2; _h="$*" ;; esac
  _avant=$(places)
  if [ -s "$V/lourds-max.retour" ]; then read -r _avant _ < "$V/lourds-max.retour"; fi
  # Une baisse dit toujours son heure de retour ; une hausse peut la dire (20 novembre 2026 : la tablette montée à trois
  # lourds jusqu'au lundi 8 h), sinon elle est permanente.
  if [ "$_n" -lt "$_avant" ] || [ -n "$_h" ]; then
    [ -n "$_h" ] || { echo "poste places : une baisse ($_avant → $_n) dit son heure de retour : poste places $_n jusqu'à HH:MM" >&2; exit 2; }
    _quand=$(date -d "$_h" +%s 2>/dev/null) || { echo "poste places : heure illisible « $_h » (HH:MM, ou AAAA-MM-JJ HH:MM)" >&2; exit 2; }
    [ "$_quand" -gt "$(date +%s)" ] || _quand=$((_quand + 86400))
    echo "$_n" > "$V/lourds-max"; echo "$_avant $_quand" > "$V/lourds-max.retour"
    echo "poste : places réglées à $_n jusqu'au $(date -d "@$_quand" '+%d/%m %H:%M'), puis $_avant"
  else
    echo "$_n" > "$V/lourds-max"; rm -f "$V/lourds-max.retour"
    echo "poste : $_n places"
  fi
  exit 0
fi
case "$mode" in mesure|cpu|gpu) ;; *) usage ;; esac
# **Une validation au-dessus du plafond du confineur est refusée avant la file** (15 novembre 2026, ticket d'hotfixs,
# mot de c7) : `scripts/confiner_validation.py` exige un plafond effectif d'au plus 32 Gio, et refusait en 0,18 s une
# passe qui avait attendu sa place sous le défaut de 40G (5 min 23 s à luciepc). Une commande qui nomme une entrée de
# validation est jugée ici, avant la file ; le défaut de 40G reste celui des autres lourds (un bâti, un banc).
# VALIDATION_MEMORY_MAX est MAX_MEMOIRE de confiner_validation.py, en octets : le témoin (test_poste.sh) les compare.
VALIDATION_MEMORY_MAX=34359738368
to_bytes() { # 40G, 32768M, 512K, 34359738368 → des octets ; vide si la valeur ne se lit pas
  echo "$1" | awk '/^[0-9]+[KMGTkmgt]?$/ { u = toupper(substr($0, length($0))); n = $0; m = 1
    if (u ~ /[KMGT]/) { n = substr(n, 1, length(n) - 1); m = (u == "K") ? 1024 : (u == "M") ? 1048576 : (u == "G") ? 1073741824 : 1099511627776 }
    printf "%.0f\n", n * m }'
}
for _a in "$@"; do
  case "$_a" in
    *run_e2e.sh*|*temoins_navigateur.sh*|*passe_epinglee.sh*|*confiner_validation.py*)
      _o=$(to_bytes "$MEM")
      if [ -n "$_o" ] && [ "$_o" -gt "$VALIDATION_MEMORY_MAX" ]; then
        echo "poste: refusé avant la file : une validation ($(basename "${_a%% *}")) sous un plafond de $MEM, au-dessus des 32 Gio du confineur — lancer sous POSTE_MEM_MAX=32G" >&2
        exit 2
      fi
      break ;;
  esac
done
[ $# -eq 0 ] && usage

if command -v systemd-run >/dev/null 2>&1 && systemd-run --user --scope -q -- true 2>/dev/null; then
  borne=1
else
  echo "poste: systemd-run indisponible, la commande tourne SANS plafond de mémoire" >&2
  borne=0
fi

# ── La priorité au travail exclusif (11 octobre 2026, au soir) ─────────────
# La mesure des fils du cœur a expiré à 21 h 45 sans avoir couru : elle tenait
# la porte et attendait la place, que des lourds « entrés quand même » après
# 600 s à la porte ne laissaient jamais vide (ticket
# 2026-10-11-une-mesure-attend-sans-fin-derriere-des-lourds-qui-entrent-quand-meme).
# La forme, celle d'un ordonnanceur qui donne la priorité à l'exclusif :
# - une mesure prend la porte, puis la place exclusive ; elle tient la porte
#   tout du long : dès qu'une mesure attend, aucun lourd n'entre plus ;
# - un lourd franchit la porte (la prend et la rend aussitôt), puis prend la
#   place partagée : il n'attend qu'une mesure, jamais un autre lourd ; le
#   « entre quand même » n'existe plus (POSTE_PORTE_MAX est ignoré) ;
# - le délai d'une mesure (POSTE_MESURE_MAX, en secondes) ne court qu'une fois
#   la place prise : jamais `timeout N poste mesure …`, dont le délai se
#   consumait à attendre ; une mesure qui le dépasse est arrêtée (124).
# Les verrous sont tenus par ce script (descripteurs 8 et 9), jamais transmis
# à la commande (`8>&- 9>&-`) : un orphelin de la commande ne tient pas la
# place (le `tail -f` du 11 octobre, 2 h 35), et la place tombe à notre fin.
# ── Un poste sous un poste (12 octobre 2026) ──────────────────────────────
# Une commande lancée par `poste mesure|lourd` qui appelle elle-même `poste`
# (run_e2e.sh bâtit par `poste lourd`) attendait sa propre place sans fin : la
# porte ou l'exclusif que son ancêtre tient (ticket
# 2026-10-12-un-poste-sous-un-poste-attend-sa-propre-place). Le poste reconnaît
# lui-même un ancêtre tenant — un pid de la chaîne de ses parents dont la fiche
# dit « tient » — et passe sans verrou ni nouvelle portée, mesure ou lourd :
# la place est déjà prise pour lui. Aucune variable à poser.
# ── Le budget mémoire (24 novembre 2026) ────────────────────────────────────
# Le 23 novembre à 18 h 47, quatre passes (jusqu'à 17,7 Gio chacune ; médiane 10,7, p90 13,2 sur 398 passes du
# pousseur) ont rempli le swap de luciepc, et systemd-oomd a tué la session graphique, qui tenait le plus de swap
# (ticket docs/optimiseur/tickets/2026-11-23-poste-compte-les-coeurs-pas-la-memoire.md). Les places comptaient les
# cœurs, jamais la mémoire. Un lourd qui a sa place n'entre que si :
# - MemAvailable couvre son pic attendu (POSTE_PIC_ATTENDU, défaut 14G : un peu plus que le p90 d'une passe ; un
#   travail plus petit le déclare plus bas) plus la réserve du poste à écran (POSTE_RESERVE_ECRAN, défaut 12G) ;
# - au moins POSTE_MEM_RECUL secondes (défaut 90) ont passé depuis l'entrée du lourd d'avant : sa croissance ne se
#   voit pas encore dans MemAvailable.
# Sinon il garde son rang et attend, en disant pourquoi. POSTE_MEMINFO : un autre meminfo, pour les témoins. Un
# meminfo illisible n'arrête rien.
mem_admet() {
  raison=""
  _disp=$(awk '$1 == "MemAvailable:" {printf "%d", $2 * 1024}' "${POSTE_MEMINFO:-/proc/meminfo}" 2>/dev/null)
  [ -n "$_disp" ] || return 0
  _pic=$(to_bytes "${POSTE_PIC_ATTENDU:-14G}"); _res=$(to_bytes "${POSTE_RESERVE_ECRAN:-12G}")
  if [ "$_disp" -lt $(( ${_pic:-0} + ${_res:-0} )) ]; then
    raison="mémoire : $((_disp / 1073741824)) Gio disponibles, il en faut $(( (${_pic:-0} + ${_res:-0}) / 1073741824 )) (pic attendu + réserve de l'écran)"
    return 1
  fi
  _der=$(cat "$V/derniere-entree" 2>/dev/null); _recul=${POSTE_MEM_RECUL:-90}
  case "$_der" in ''|*[!0-9]*) _der=0 ;; esac
  if [ $(( $(date +%s) - _der )) -lt "$_recul" ]; then
    raison="mémoire : un lourd est entré il y a moins de $_recul s, sa croissance ne se voit pas encore"
    return 1
  fi
  return 0
}

ancetre_tenant() {
  p=$PPID
  while [ -n "$p" ] && [ "$p" -gt 1 ]; do
    if [ -f "$F/$p" ]; then
      case "$(cat "$F/$p" 2>/dev/null)" in tient*) echo "$p"; return 0 ;; esac
    fi
    p=$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')
  done
  return 1
}
GPU_NESTED=""
if tenant=$(ancetre_tenant); then
  # Un gpu sous un ancêtre qui ne tient pas de mémoire (cpu, lourd) fait quand même son admission mémoire, sous le verrou
  # des gpu et sans la porte (une mesure qui attend l'ancêtre ne l'attend pas) ; sous un gpu ou une mesure, il passe.
  case "$mode $(cut -d' ' -f2 "$F/$tenant" 2>/dev/null)" in
    "gpu cpu"|"gpu lourd") GPU_NESTED=$tenant ;;
    *) echo "poste: un ancêtre tient déjà la place ($(cut -d' ' -f1-2 "$F/$tenant" 2>/dev/null), pid $tenant) : ce $mode passe sans verrou" >&2
       exec "$@" ;;
  esac
fi
# Le timeout en tête de la commande d'un gpu (card0 l'exige), en secondes ; puis les refus qui n'attendent pas.
GPU_TIMEOUT_S=""
if [ "$mode" = gpu ]; then
  _d=""
  if [ "${1:-}" = timeout ]; then
    _p=0; for _x in "$@"; do _p=$((_p + 1)); [ "$_p" = 1 ] && continue; case "$_x" in -*) continue ;; *) _d=$_x; break ;; esac; done
  fi
  _v=${_d%[smhd]}
  case "$_v" in ''|*[!0-9]*) ;; *) case "$_d" in *m) _v=$((_v * 60)) ;; *h) _v=$((_v * 3600)) ;; *d) _v=$((_v * 86400)) ;; esac; GPU_TIMEOUT_S=$_v ;; esac
  _refus=$(gpu_refusal_now)
  if [ -n "$_refus" ]; then echo "${_refus#* }" >&2; exit "${_refus%% *}"; fi
  [ -n "$(gpu_card)" ] && { POSTE_GPU_CARD=$(gpu_card); export POSTE_GPU_CARD; }
fi
mkdir -p "$F"
fiche="$F/$$"
resume=$(printf '%s ' "$@" | cut -c1-90)
dire() { echo "$1 $classe depuis $(date +%H:%M:%S) (pid $$) — $resume" > "$fiche"; }
trap 'rm -f "$fiche"' EXIT
# **Attendre un verrou sans se rendre sourd** (12 octobre 2026, luciepc : deux
# bâtis annulés restaient bloqués dans flock, le signal n'étant traité qu'au
# retour de flock). flock attend en fond, le script attend flock par `wait`,
# qu'un signal interrompt ; un flock qui échoue ou meurt arrête le script, qui
# ne lance alors jamais sa commande. Le verrou pris par l'enfant appartient au
# descripteur partagé : il reste tenu par ce script.
attente=""
prendre() { flock "$@" & attente=$!; wait "$attente"; r=$?; attente=""; [ "$r" = 0 ] || exit 75; }
trap '[ -n "$attente" ] && kill "$attente" 2>/dev/null; exit 143' TERM INT HUP
FILS=$(fils_par "$( [ "$mode" = mesure ] && echo mesure || echo lourd)")
borner_fils "$FILS"
# sccache et mold (19 novembre 2026, c7 ; posés par Lucie aux deux postes) : treize targets recompilaient chacun les
# mêmes dépendances. Quand ils sont là, une commande compile par sccache (cache sur disque hors de /tmp, plafond 40G) et
# lie par mold, à travers clang. Une variable déjà posée par l'appelant, même vide, l'emporte.
# sccache a été en opt-in du 19 au 20 novembre 2026 : le bac à sable du produit héritait de RUSTC_WRAPPER, et son cargo
# y échouait par intermittence, « Permission denied » (ticket d'optimiseur ; c7). Le bac retire désormais RUSTC_WRAPPER
# et SCCACHE_* (lot bac-sans-sccache d'archi, 20d406a82c) : sccache redevient le défaut, POSTE_SCCACHE=0 le coupe.
if [ "${POSTE_SCCACHE:-1}" = 1 ] && command -v sccache > /dev/null 2>&1; then
  [ -n "${RUSTC_WRAPPER+posée}" ] || export RUSTC_WRAPPER=sccache
  [ -n "${SCCACHE_DIR+posée}" ] || export SCCACHE_DIR="$HOME/.cache/sccache"
  [ -n "${SCCACHE_CACHE_SIZE+posée}" ] || export SCCACHE_CACHE_SIZE=40G
fi
if command -v mold > /dev/null 2>&1 && command -v clang > /dev/null 2>&1 && [ -z "${CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER+posée}" ]; then
  export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER=clang
  [ -n "${CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS+posée}" ] || export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-C link-arg=-fuse-ld=mold"
fi
# **L'iGPU autorisé à l'embarqueur par un fichier déclaré du poste** (20 novembre 2026, c7 et embarquement) : un
# embarqueur burn refuse un adaptateur intégré, car l'Intel ARL de luciepc (anv) rend des vecteurs faux. L'APU Radeon
# 8060S de la tablette (radv) calcule juste, mesuré contre card2. Le fichier `embedder-allow-integrated-gpu` du dossier
# des verrous, posé à la tablette seulement, porte la référence de cette mesure ; il autorise, il ne force rien. Une
# variable déjà posée par l'appelant l'emporte.
if [ -s "$V/embedder-allow-integrated-gpu" ] && [ -z "${RAG3WEAVER_EMBEDDER_ALLOW_INTEGRATED_GPU+posée}" ]; then
  export RAG3WEAVER_EMBEDDER_ALLOW_INTEGRATED_GPU=1
fi
QUOTA="${POSTE_CPU_QUOTA:-$((FILS * 100))%}"
# Un gpu en mémoire unifiée alloue sa « VRAM » dans la RAM : le plafond de la portée tient au moins son besoin, plus 8 Gio.
if [ "$mode" = gpu ] && [ -z "$(gpu_card)" ] && [ -z "${POSTE_MEM_MAX:-}" ]; then
  _m=$(to_bytes "$MEM"); _w=$(( (GPU_NEED + 8) * 1073741824 ))
  [ -n "$_m" ] && [ "$_w" -gt "$_m" ] && MEM=$((GPU_NEED + 8))G
fi
if [ "$borne" = 1 ]; then
  # **Delegate=yes** (20 novembre 2026, c7 et recherche) : le confineur de validation partageait la portée plafonnée avec
  # sa commande, et un débordement le tuait en seconde victime (-9, aucun verdict.json ; vu par `journalctl -k` aux deux
  # postes). Déléguée, la portée laisse le confineur y créer deux feuilles, superviseur et commande, plafonner la
  # seconde sous la portée et arrêter lui-même la commande ; le plafond de poste contient toujours tout.
  set -- systemd-run --user --scope -q -p Delegate=yes -p MemoryMax="$MEM" -p MemorySwapMax="$SWAP" -p CPUQuota="$QUOTA" -- "$@"
fi
# fin_prevue <fiche> <commande…> : l'instant de fin prévu d'un lourd (secondes), vide si sa commande n'a pas de timeout en
# tête (après des `env VAR=…`). Une fonction : ses arguments ne touchent pas à la commande de ce poste.
fin_prevue() {
  _fp=$1; shift
  while [ $# -gt 0 ] && { [ "$1" = env ] || case "$1" in *=*) true ;; *) false ;; esac; }; do shift; done
  [ "${1:-}" = timeout ] || return 0
  shift; while [ $# -gt 0 ] && case "$1" in -*) true ;; *) false ;; esac; do case "$1" in -k|-s|--kill-after|--signal) shift ;; esac; shift; done
  _d=${1:-}; _n=${_d%[smhd]}
  case "$_n" in ''|*[!0-9]*) return 0 ;; esac
  case "$_d" in *m) _n=$((_n * 60)) ;; *h) _n=$((_n * 3600)) ;; *d) _n=$((_n * 86400)) ;; esac
  echo $(( $(stat -c %Y "$_fp") + _n ))
}
# **Une lib plus vieille que l'épinglée est refusée au départ** (23 novembre 2026, c7 : trois sessions ont attendu une
# heure une place à luciepc avec RAG3DB_LIB sur 2c4bddcd3c, alors que lib-des-passes disait 4669d5f723 depuis 21 h 32 ; la
# garde du moteur l'a refusée ensuite, et les e2e ont rendu 1 sans jouer un test). Seule une lib du magasin
# (rag3db-build-<commit>-…) se compare : si son commit est un ancêtre strict de celui de la lib épinglée, code 78 avant
# tout billet, avec la lib à prendre. Un bâti à soi (bati), courant, ou un commit inconnu du dépôt (dit) passent.
case "${RAG3DB_LIB:-}" in
  rag3db-build-*)
    _ep=$(head -1 "$V/lib-des-passes" 2>/dev/null); _dep=${POSTE_DEPOT:-$HOME/git_workspaces/rag3db}
    _cl=$(printf '%s' "$RAG3DB_LIB" | sed -n 's/^rag3db-build-\([0-9a-f]\{40\}\)-.*/\1/p')
    _ce=$(printf '%s' "$_ep" | sed -n 's/^rag3db-build-\([0-9a-f]\{40\}\)-.*/\1/p')
    if [ -n "$_cl" ] && [ -n "$_ce" ] && [ "$_cl" != "$_ce" ]; then
      if ! git -C "$_dep" cat-file -e "$_cl^{commit}" 2>/dev/null || ! git -C "$_dep" cat-file -e "$_ce^{commit}" 2>/dev/null; then
        echo "poste: la lib $(printf '%.10s' "$_cl") ou l'épinglée $(printf '%.10s' "$_ce") est d'un commit inconnu de $_dep : fraîcheur non contrôlée" >&2
      elif git -C "$_dep" merge-base --is-ancestor "$_cl" "$_ce" 2>/dev/null; then
        echo "poste: RAG3DB_LIB=$RAG3DB_LIB est plus vieille que la lib épinglée : prendre RAG3DB_LIB=$_ep (lib-des-passes) ; rien n'est lancé, aucune place prise" >&2
        exit 78
      fi
    fi ;;
esac
dire attend
case "$mode" in
  mesure)
    # **Une mesure refuse à l'arrivée derrière un lourd long** (20 novembre 2026, c7 : deux gels de la file en deux heures
    # à luciepc, une mesure tenant la porte derrière un lourd de six heures). La fin prévue d'un lourd qui tient sa place :
    # l'instant de sa fiche « tient », plus le `timeout N` en tête de sa commande (après des `env VAR=…`) ; sans timeout,
    # elle est inconnue, donc longue. Au-delà de POSTE_MESURE_ATTENTE_MAX secondes (1200 ; 0 coupe la règle), la mesure
    # refuse tout de suite, code 76, et dit quel lourd, sa fin prévue, et quoi faire.
    if [ "${POSTE_MESURE_ATTENTE_MAX:-1200}" != 0 ]; then
      maintenant=$(date +%s); limite=$((maintenant + ${POSTE_MESURE_ATTENTE_MAX:-1200}))
      for _f in "$F"/*; do
        [ -f "$_f" ] && [ "$_f" != "$fiche" ] || continue
        _l=$(cat "$_f" 2>/dev/null); case "$_l" in "tient mesure"*) continue ;; "tient "*) ;; *) continue ;; esac
        kill -0 "${_f##*/}" 2>/dev/null || continue
        _cmd=${_l#* — }; set -f; _fin=$(fin_prevue "$_f" $_cmd); set +f
        if [ -z "$_fin" ] || [ "$_fin" -gt "$limite" ]; then
          if [ -n "$_fin" ]; then _quand="fin prévue à $(date -d "@$_fin" +%H:%M)"; _apres=" ou après $(date -d "@$_fin" +%H:%M)"; else _quand="fin inconnue (pas de timeout en tête)"; _apres=""; fi
          echo "poste: mesure refusée : le lourd pid ${_f##*/} tient sa place, $_quand — ${_cmd} ; rejouer sous poste lourd$_apres" >&2
          exit 76
        fi
      done
    fi
    exec 8>>"$V/porte.lock"; prendre -x 8
    exec 9>>"$V/poste.lock"; prendre -x 9
    dire tient
    [ -n "${POSTE_MESURE_MAX:-}" ] && set -- timeout "$POSTE_MESURE_MAX" "$@"
    "$@" 8>&- 9>&-
    rc=$? ;;
  cpu|gpu)
    # La porte, puis une des N places, dans l'ordre d'arrivée. Chaque essai se fait
    # porte tenue : une mesure qui attend la tient, et aucun lourd n'entre derrière
    # elle ; deux lourds ne comptent jamais les places en même temps. Le billet part
    # et la fiche dit « tient » avant que la porte soit rendue.
    # POSTE_LOURD_ATTENTE_MAX (secondes, pour `push --lourd`) : au-delà, code 75, rien de pris.
    # Un cpu, ou un gpu --cpu, prend une place de cœurs ; un gpu prend aussi son billet dans la file des gpu. Un gpu sous
    # un ancêtre cpu n'a que son admission mémoire, sous le verrou des gpu (gpu.lock), sans la porte ni le partagé.
    prend_cpu=1; { [ "$mode" = gpu ] && [ "$GPU_CPU" = 0 ]; } && prend_cpu=0; [ -n "$GPU_NESTED" ] && prend_cpu=0
    mkdir -p "$T" "$TG"; billet=/dev/null; gpu_ticket=/dev/null
    if [ "$prend_cpu" = 1 ]; then
      if [ "${POSTE_VOIE:-}" = pousseur ]; then billet="$T/0-$(date +%s%N)-$$"; else billet="$T/$(date +%s%N)-$$"; fi
      : > "$billet"
    fi
    [ "$mode" = gpu ] && { gpu_ticket="$TG/$(date +%s%N)-$$"; : > "$gpu_ticket"; }
    # Les billets valent /dev/null quand ce travail n'en a pas : jamais un chemin vide à effacer.
    trap '[ "$billet" = /dev/null ] || rm -f -- "$billet"; [ "$gpu_ticket" = /dev/null ] || rm -f -- "$gpu_ticket"; rm -f -- "$fiche"' EXIT
    [ -z "$GPU_NESTED" ] && exec 9>>"$V/poste.lock"
    debut=$(date +%s); raison_dite=""
    while :; do
      if [ -n "$GPU_NESTED" ]; then exec 8>>"$V/gpu.lock"; else exec 8>>"$V/porte.lock"; fi
      if [ -n "${POSTE_LOURD_ATTENTE_MAX:-}" ]; then prendre -w "$POSTE_LOURD_ATTENTE_MAX" -x 8; else prendre -x 8; fi
      passe=1
      if [ "$prend_cpu" = 1 ]; then
        max=$(places); tenus=$(lourds_tenus); rang=$(file_des_lourds "$billet")
        # La place réservée (19 novembre 2026, c7 : quatre mesures longues de sessions ont figé la file du pousseur une
        # heure) : sur un poste qui la déclare (le fichier `place-pousseur` du dossier des verrous, là où tourne le
        # pousseur) et à partir de deux places, un lourd hors de la voie du pousseur n'en compte que N-1 ; la dernière
        # reste au pousseur. Ailleurs, les sessions ont les N places.
        [ -e "$V/place-pousseur" ] && [ "${POSTE_VOIE:-}" != pousseur ] && [ "$max" -ge 2 ] && max=$((max - 1))
        { [ "$tenus" -lt "$max" ] && [ "$rang" -lt $((max - tenus)) ]; } || passe=0
        # Le budget mémoire, une fois la place acquise ; la raison d'attendre dite une fois, quand elle change.
        if [ "$passe" = 1 ] && ! mem_admet; then
          passe=0; [ "$raison" = "$raison_dite" ] || { echo "poste: attend — $raison" >&2; raison_dite=$raison; }
        fi
      fi
      if [ "$mode" = gpu ] && [ "$passe" = 1 ]; then
        # L'admission mémoire sous le verrou des gpu : deux gpu, l'un sous la porte et l'autre sous un ancêtre cpu, ne
        # comptent jamais la mémoire en même temps.
        if [ -z "$GPU_NESTED" ]; then exec 7>>"$V/gpu.lock"; prendre -x 7; fi
        { [ "$(gpu_queue "$gpu_ticket")" = 0 ] && gpu_admits; } || passe=0
      fi
      if [ "$passe" = 1 ] && { [ -n "$GPU_NESTED" ] || flock -n -s 9; }; then
        [ "$billet" = /dev/null ] || rm -f -- "$billet"; [ "$gpu_ticket" = /dev/null ] || rm -f -- "$gpu_ticket"
        [ "$prend_cpu" = 1 ] && date +%s > "$V/derniere-entree"
        dire tient
        if [ "$mode" = gpu ] && [ -z "$GPU_NESTED" ]; then flock -u 7; exec 7>&-; fi
        flock -u 8; exec 8>&-
        break
      fi
      if [ "$mode" = gpu ] && [ -z "$GPU_NESTED" ]; then flock -u 7 2>/dev/null; exec 7>&-; fi
      flock -u 8; exec 8>&-
      if [ -n "${POSTE_LOURD_ATTENTE_MAX:-}" ] && [ $(( $(date +%s) - debut )) -ge "$POSTE_LOURD_ATTENTE_MAX" ]; then exit 75; fi
      sleep 1 & attente=$!; wait "$attente"; attente=""
    done
    unset POSTE_LOURD_ATTENTE_MAX
    nice -n 15 ionice -c 3 "$@" 7>&- 9>&-
    rc=$? ;;
esac
exit "$rc"
